# ---------------------------------------------------------------------------
#  Vitals
# ---------------------------------------------------------------------------
#
# Memory is the failure mode worth watching on this hardware. A run that fits
# in RAM is fast; a run that spills to swap is not merely slower but a
# different order of magnitude, because every integration step touches the
# whole coordinate array and so every step faults. The distinction does not
# show up in ns/day until it is far too late to do anything about it, and the
# machine gives no other warning, so the readout is on screen throughout.

_SWAP_AT_START = None
_SWAP_WARNED = [False]


def vitals():
    """RSS, free memory and swap, as a compact string for a progress line."""
    try:
        rss = psutil.Process().memory_info().rss
        vm = psutil.virtual_memory()
        sw = psutil.swap_memory()
    except Exception:               # psutil is best-effort; never break a run for it
        return ""

    grown = sw.used - (_SWAP_AT_START if _SWAP_AT_START is not None else sw.used)
    swap_style = "warn" if grown > 256e6 else "muted"
    swap = f"[{swap_style}]{_human_bytes(sw.used)} swap[/{swap_style}]"

    # Budgeted against the terminal, because the progress row already carries a
    # bar, a percentage, ns/day, elapsed and an ETA. Overflowing it makes rich
    # truncate the RIGHT-hand columns, which are the ETA and the swap figure --
    # the two most useful things on the line. So the vitals give ground first,
    # and swap is the last thing dropped.
    if console.width >= 118:
        return (f"[muted]{_human_bytes(rss)} rss \u00b7 "
                f"{_human_bytes(vm.available)} free \u00b7[/muted] {swap}")
    if console.width >= 96:
        return f"[muted]{_human_bytes(rss)} rss \u00b7[/muted] {swap}"
    return swap if grown > 0 else ""


def watch_swap():
    """Warn once, loudly, the first time this run pushes the machine into swap.

    Only counts growth since the run started: a machine with a few hundred MB
    already swapped from earlier work is not a problem, and warning about it
    would train the reader to ignore the message that matters.
    """
    if _SWAP_AT_START is None or _SWAP_WARNED[0]:
        return
    try:
        grown = psutil.swap_memory().used - _SWAP_AT_START
    except Exception:
        return
    if grown > 512e6:
        _SWAP_WARNED[0] = True
        console.print()
        warn(f"the machine has swapped {_human_bytes(grown)} since this run began.")
        warn("MD throughput collapses once coordinates leave RAM. Close other "
             "applications, or stop and rebuild with a smaller box.")


def _human_bytes(n):
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000.0
    return f"{n:.1f} TB"


# ---------------------------------------------------------------------------
#  Progress
# ---------------------------------------------------------------------------
#
# Several stages here are long and silent -- solvating a large box, minimising,
# and the equilibration before production. A run that prints nothing for four
# minutes is indistinguishable from a run that has hung, so every stage now
# reports.
#
# Two shapes, because the work comes in two shapes. Anything whose length is
# known in advance (integration steps, a bounded minimisation) gets a bar with
# a percentage and an estimate. Anything that blocks inside OpenMM with no
# callback to hook -- addSolvent, addMembrane, createSystem -- gets a spinner,
# which at least distinguishes "working" from "stuck".
#
# Both degrade when stdout is not a terminal. A live region redrawing into a
# log file produces an unreadable mess, so a non-terminal gets periodic
# milestone lines instead -- which is also what makes the output of a `nohup`
# run readable afterwards.

_BAR_WIDTH = 20
_LOG_EVERY_SECONDS = 20


def _fmt_duration(seconds):
    if seconds is None or seconds != seconds or seconds < 0:
        return "--"
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def _bar_columns():
    """Columns shared by every determinate bar in this script."""
    return [
        TextColumn("  [step]{task.description}[/step]"),
        BarColumn(bar_width=_BAR_WIDTH, complete_style="bar.complete",
                  finished_style="bar.finished", pulse_style="bar.pulse"),
        TaskProgressColumn(),
        TextColumn("{task.fields[extra]}"),
        TextColumn("[muted]{task.fields[vitals]}[/muted]"),
        TimeElapsedColumn(),
        TimeRemainingColumn(compact=True),
    ]


class Progress:
    """A bar for work whose total is known up front.

    Wraps rich rather than exposing it, because the call sites here update by
    absolute step count from inside an integration loop, and because the
    non-terminal path has to stay a handful of printed lines rather than a
    live region.
    """

    def __init__(self, total, label):
        self.total = max(1, int(total))
        self.label = label
        self.started = time.time()
        self._last_logged = -1
        self._bar = RichProgress(*_bar_columns(), console=console,
                                 transient=True, disable=not _TTY)
        self._task = self._bar.add_task(label, total=self.total, extra="", vitals="")
        self._bar.start()

    def update(self, done, extra=""):
        done = max(0, min(int(done), self.total))
        if _TTY:
            # rich throttles its own redraws, so there is no need to rate-limit
            # here as the hand-rolled version did.
            self._bar.update(self._task, completed=done, extra=extra, vitals=vitals())
            watch_swap()
            return
        elapsed = time.time() - self.started
        bucket = int(elapsed // _LOG_EVERY_SECONDS)
        if bucket > self._last_logged:
            self._last_logged = bucket
            console.print(f"  {self.label}: {done / self.total * 100:.0f}% {extra} "
                          f"({_fmt_duration(elapsed)})")
            watch_swap()

    def close(self, message=""):
        self._bar.stop()
        if message:
            ok(f"{message}  [muted]{_fmt_duration(time.time() - self.started)}[/muted]")


class Spinner:
    """An indeterminate ticker for a blocking call with no progress callback.

    Used as a context manager. On a terminal rich animates it on its own
    refresh thread while the main thread does the work; elsewhere it prints one
    line on entry and one on exit, so a log still shows the stage and its
    duration.
    """

    def __init__(self, label):
        self.label = label
        self.started = time.time()
        self._bar = RichProgress(
            SpinnerColumn(style="step"),
            TextColumn("  [step]{task.description}[/step]"),
            TextColumn("[muted]{task.fields[vitals]}[/muted]"),
            TimeElapsedColumn(),
            console=console, transient=True, disable=not _TTY)
        self._task = None

    def __enter__(self):
        if _TTY:
            self._task = self._bar.add_task(self.label, total=None, vitals=vitals())
            self._bar.start()
        else:
            step(self.label)
        return self

    def tick(self):
        """Refresh the vitals. Optional -- rich animates the spinner itself."""
        if self._task is not None:
            self._bar.update(self._task, vitals=vitals())

    def __exit__(self, *exc):
        self._bar.stop()
        return False

    def close(self, message):
        self.__exit__()
        ok(f"{message}  [muted]{_fmt_duration(time.time() - self.started)}[/muted]")


class MinimisationProgress(openmm.MinimizationReporter):
    """Liveness and the falling energy during minimizeEnergy, which is silent.

    OpenMM calls report(iteration, x, grad, args) and stops early if it returns
    True. Note the four arguments: Python's introspection of the base class
    reports three, and a three-argument override fails with a TypeError.

    Deliberately a spinner and not a percentage bar. The `iteration` argument is
    not monotonic -- the L-BFGS minimiser restarts, so it climbs, resets to zero
    and climbs again (measured: 1530 calls, three resets, a final value of 29
    after peaking at 499). A bar driven by it runs backwards, and the total work
    is not knowable in advance. What is meaningful is the energy coming down, so
    that is what this shows, next to a count of the iterations actually done.
    """

    def __init__(self, label, _unused_total=0):
        super().__init__()
        self.label = label
        self.started = time.time()
        self.iterations = 0
        self.energy = None
        self._last = 0.0
        self._bar = RichProgress(
            SpinnerColumn(style="step"),
            TextColumn("  [step]{task.description}[/step]"),
            TextColumn("[value]{task.fields[energy]}[/value]"),
            TextColumn("[muted]{task.fields[iters]}[/muted]"),
            TextColumn("[muted]{task.fields[vitals]}[/muted]"),
            TimeElapsedColumn(),
            console=console, transient=True, disable=not _TTY)
        self._task = self._bar.add_task(label, total=None, energy="", iters="", vitals="")
        self._bar.start()

    def report(self, iteration, x, grad, args):
        self.iterations += 1          # counted, not taken from a resetting argument
        # `args` is OpenMM's mapstringdouble, which supports subscripting but has
        # no .get(). Guarding with hasattr(args, "get") therefore skipped the
        # energy silently on every call and the display came out blank.
        try:
            self.energy = args["system energy"]
        except (KeyError, TypeError):
            pass

        now = time.time()
        detail = f"{self.energy:,.0f} kJ/mol" if self.energy is not None else ""

        if _TTY:
            self._bar.update(self._task, energy=detail,
                             iters=f"{self.iterations:,} iterations", vitals=vitals())
        elif now - self._last >= _LOG_EVERY_SECONDS:
            self._last = now
            console.print(f"  {self.label}: {detail} after {self.iterations:,} iterations "
                          f"({_fmt_duration(now - self.started)})")
        return False

    def close(self, message):
        self._bar.stop()
        ok(f"{message}  [muted]{_fmt_duration(time.time() - self.started)}[/muted]")


def run_chunked(simulation, steps, bar, offset, extra=lambda: ""):
    """Integrate `steps`, driving a bar that spans several calls.

    Heating and equilibration are staged -- a temperature ramp, a restraint
    release schedule -- but a bar per stage would flicker through five in a row
    and tell the reader nothing about the whole. One bar, advanced by `offset`,
    reads as the single operation it is.
    """
    chunk = max(100, steps // 50)
    done = 0
    while done < steps:
        n = min(chunk, steps - done)
        simulation.step(n)
        done += n
        bar.update(offset + done, extra())


def run_steps(simulation, total, label, extra=lambda: ""):
    """Integrate `total` steps, updating a bar as it goes.

    Stepping in chunks rather than one call so there is something to report.
    The chunk is a percent of the run, floored at 100 steps, which keeps the
    per-call overhead irrelevant next to the integration itself.
    """
    if total <= 0:
        return
    bar = Progress(total, label)
    chunk = max(100, total // 100)
    done = 0
    while done < total:
        n = min(chunk, total - done)
        simulation.step(n)
        done += n
        bar.update(done, extra())
    bar.close()
    return bar


# ---------------------------------------------------------------------------
#  Atom selection
# ---------------------------------------------------------------------------

# Standard residue names, including the protonation-state variants both AMBER
# and CHARMM use. Kept explicit rather than inferred: OpenMM's Topology has no
# concept of "is this protein", and guessing from connectivity is worse.
_PROTEIN_RESIDUES = {
    "ALA", "ARG", "ASN", "ASP", "CYS", "GLN", "GLU", "GLY", "HIS", "ILE",
    "LEU", "LYS", "MET", "PHE", "PRO", "SER", "THR", "TRP", "TYR", "VAL",
    "HID", "HIE", "HIP", "HSD", "HSE", "HSP", "CYX", "CYM", "ASH", "GLH",
    "LYN", "ACE", "NME", "NMA", "SEC", "PYL",
}
_SOLVENT_RESIDUES = {
    "HOH", "WAT", "TIP3", "TIP4", "SOL", "NA", "CL", "K", "MG", "CA", "ZN",
    "LI", "RB", "CS", "BR", "F", "IOD", "SOD", "CLA", "POT",
}
# Both spellings on purpose. A PDB residue name field is three characters, so a
# four-character lipid is truncated the moment anything is written or read as
# PDB: POPC becomes POP, DPPC becomes DPP. Matching only the full name means
# every lipid silently fails to match and the whole bilayer lands in selections
# meant to exclude it.
_LIPID_RESIDUES = {
    "POPC", "POPE", "DLPC", "DLPE", "DMPC", "DOPC", "DPPC",
    "POP", "DLP", "DMP", "DOP", "DPP",
}


def select_atoms(topology, selection):
    """Atom indices for a named selection. Returns None for 'everything'."""
    if selection == "all":
        return None

    indices = []
    for atom in topology.atoms():
        name = atom.residue.name
        is_protein = name in _PROTEIN_RESIDUES
        is_solvent = name in _SOLVENT_RESIDUES
        is_lipid = name in _LIPID_RESIDUES
        is_hydrogen = atom.element is not None and atom.element.symbol == "H"

        if selection == "protein":
            keep = is_protein
        elif selection == "protein_heavy":
            keep = is_protein and not is_hydrogen
        elif selection == "backbone":
            keep = is_protein and atom.name in ("N", "CA", "C", "O")
        elif selection == "ca":
            keep = is_protein and atom.name == "CA"
        elif selection == "protein_ligand":
            keep = not is_solvent and not is_lipid
        else:
            raise ValueError(f"unknown selection {selection!r}")

        if keep:
            indices.append(atom.index)
    return indices


# ---------------------------------------------------------------------------
#  Memory guard
# ---------------------------------------------------------------------------

{% if cfg.memory_guard %}
def check_memory(n_atoms):
    """Refuse to start if the run would push the machine into swap.

    Swapping during molecular dynamics does not merely slow a run down -- it can
    turn hours into days, because every step touches the whole coordinate array.
    The estimate is deliberately crude and generous; it exists to catch the
    order-of-magnitude mistake, not to predict usage.
    """
    try:
        total = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
    except (ValueError, OSError, AttributeError):
        return  # Unknown platform: say nothing rather than guess.

    estimated = 1.5e9 + n_atoms * 2500      # baseline + per-atom working set
    if estimated > total * 0.8:
        fail(
            f"this system needs roughly {estimated / 1e9:.1f} GB but the machine has "
            f"{total / 1e9:.1f} GB. Running it would swap, which can turn a "
            f"several-hour job into a several-day one."
        )
        info("Reduce the system: fewer chains, less padding, or an octahedral box.")
        sys.exit(1)
    elif estimated > total * 0.5:
        warn(
            f"estimated memory {estimated / 1e9:.1f} GB of {total / 1e9:.1f} GB total. "
            f"Close other applications before leaving this running."
        )
{% endif %}


# ---------------------------------------------------------------------------
#  Stability
# ---------------------------------------------------------------------------

# Filled in by prepare_structure so a failure can name what was invented.
REBUILT = {"residues": 0, "longest": 0}


def explain_instability(stage):
    """Turn "Particle coordinate is NaN" into something a user can act on.

    OpenMM's own message says what happened but nothing about why, and by the
    time it appears the run has usually been going for a while. The causes are
    a short list, and which of them is plausible depends on how this particular
    bundle was configured -- so the script knows, and says.
    """
    fail(f"the system became unstable during {stage}: a coordinate went to NaN.")
    print(file=sys.stderr)
    info("That means a force went to infinity, which is nearly always one of:")

    if REBUILT["longest"] >= 8:
        info(f"  * The {REBUILT['longest']}-residue loop PDBFixer rebuilt. This is the")
        info(f"    likeliest cause here. A rebuilt loop is placed by geometry, not")
        info(f"    physics, and a long one can thread through the protein or through")
        info(f"    itself. Minimisation relieves the worst of it, and then releasing")
        info(f"    the restraints lets it spring.")
        info(f"    Try: rebuild the bundle with a lower 'longest gap to build', or")
        info(f"    simulate a construct that does not span the gap.")
{% if cfg.timestep >= 4 %}
    info("  * The {{ cfg.timestep }} fs timestep. It is safe for an equilibrated system")
    info("    but unforgiving of a strained starting structure. Try 2 fs.")
{% endif %}
{% if cfg.use_positional_restraints %}
    info("  * The restraint release. Going from "
         "{{ restraint_schedule[0] }} to 0 kJ/mol/nm² over")
    info("    {{ cfg.equilibration_duration }} ps may be too fast for this system.")
    info("    Try a longer equilibration, or more steps in the schedule.")
{% endif %}
    info("  * A clash minimisation could not resolve. Look at solvated.pdb.")
    print(file=sys.stderr)
    info("The trajectory written so far is still in the output directory, and")
    info("re-running resumes from the last checkpoint rather than starting over.")


def check_stable(simulation, stage):
    """Fail at a stage boundary rather than deep inside integrator.step().

    Cheap -- one energy read per stage -- and it means the message names the
    stage that destabilised things instead of a traceback through OpenMM's
    internals.
    """
    energy = simulation.context.getState(getEnergy=True).getPotentialEnergy()
    value = energy.value_in_unit(unit.kilojoule_per_mole)
    if math.isnan(value) or math.isinf(value):
        explain_instability(stage)
        sys.exit(1)

{% if cfg.solvent_mode == 'explicit' %}
    # A solvated system's potential energy is strongly negative -- water alone
    # contributes tens of thousands of kJ/mol of hydrogen bonding. A positive
    # total after minimisation means something is still overlapping badly, and
    # it is a reliable early warning: this run's own structure started at
    # +3.3 million kJ/mol because of a rebuilt loop threaded through itself.
    if stage == "minimisation" and value > 0:
        warn(f"potential energy is still positive after minimisation "
             f"({value:,.0f} kJ/mol). A solvated system should be strongly "
             f"negative, so something is badly overlapping and this run is "
             f"likely to become unstable.")
        if REBUILT["longest"] >= 8:
            info(f"  the {REBUILT['longest']}-residue rebuilt loop is the first "
                 f"thing to suspect; look at minimised.pdb")
{% endif %}
    return value


# ---------------------------------------------------------------------------
#  1. Structure preparation
# ---------------------------------------------------------------------------

def prepare_structure(ligands=None):
    """Repair the input structure and return an OpenMM Modeller."""
    step("preparing the structure")
{% if needs_pdbfixer %}
    fixer = PDBFixer(filename=str(INPUT))

{% if drop_chains %}
    # Keep only the requested chains. Done first so nothing below wastes effort
    # repairing something that is about to be deleted.
    chain_ids = [c.id for c in fixer.topology.chains()]
    drop = [i for i, cid in enumerate(chain_ids) if cid not in {{ keep_chains | tojson }}]
    if drop:
        fixer.removeChains(drop)
        info(f"kept chains {{ keep_chains | join(', ') }}, dropped {len(drop)}")
{% endif %}
{% if mutations %}

    # Mutations are applied before any repair, so a rebuilt loop reflects the mutant.
{% for chain_id, muts in mutations.items() %}
    fixer.applyMutations({{ muts | tojson }}, {{ chain_id | tojson }})
{% endfor %}
    info("applied {{ mutation_count }} mutation(s)")
{% endif %}

{% if cfg.fix_missing_residues %}
    fixer.findMissingResidues()
{% if not cfg.build_terminal_residues %}
    # Drop terminal gaps: unresolved termini are usually genuinely disordered
    # rather than merely unmodelled, and a flapping rebuilt tail adds atoms and
    # noise to global metrics without adding information.
    chains = list(fixer.topology.chains())
    for key in list(fixer.missingResidues):
        chain = chains[key[0]]
        if key[1] == 0 or key[1] == len(list(chain.residues())):
            del fixer.missingResidues[key]
{% endif %}
    longest = max((len(v) for v in fixer.missingResidues.values()), default=0)
    if longest > {{ cfg.max_gap_length }}:
        fail(
            f"the structure has a gap of {longest} residues, longer than the "
            f"{{ cfg.max_gap_length }}-residue limit set when this bundle was built. "
            f"A rebuilt loop that long is a guess and would dominate your RMSD."
        )
        info("Rebuild the bundle with a higher limit, or simulate a single well-resolved domain.")
        sys.exit(1)
    if fixer.missingResidues:
        REBUILT["residues"] = sum(len(v) for v in fixer.missingResidues.values())
        REBUILT["longest"] = longest
        info(f"rebuilding {REBUILT['residues']} missing residue(s), "
             f"longest run {longest}")
        if longest > 12:
            warn(f"a {longest}-residue rebuilt loop is an invention, not a "
                 f"measurement. It is the most likely thing to destabilise this "
                 f"run, and it will dominate the RMSD.")
{% else %}
    fixer.missingResidues = {}
{% endif %}

{% if cfg.replace_nonstandard %}
    fixer.findNonstandardResidues()
    if fixer.nonstandardResidues:
        info(f"replacing {len(fixer.nonstandardResidues)} non-standard residue(s)")
    fixer.replaceNonstandardResidues()
{% endif %}

    # PDBFixer has no "keep these heteroatoms" option -- removeHeterogens takes
    # everything that is not protein, nucleic or water. Any ligand being kept is
    # therefore extracted first (below) and merged back after preparation, which
    # is also the only order that works: PDBFixer cannot add hydrogens to a
    # residue it has no template for.
    fixer.removeHeterogens(keepWater={{ 'True' if cfg.keep_waters else 'False' }})

{% if cfg.add_missing_atoms %}
    fixer.findMissingAtoms()
    fixer.addMissingAtoms()
{% endif %}
{% if cfg.strip_hydrogens %}
    fixer.addMissingHydrogens({{ cfg.ph }})
    info("added hydrogens at pH {{ cfg.ph }}")
{% endif %}

    modeller = app.Modeller(fixer.topology, fixer.positions)
{% else %}
    pdb = app.PDBFile(str(INPUT))
    modeller = app.Modeller(pdb.topology, pdb.positions)
{% endif %}
{% if ligand_names %}

    # Merged after preparation, with the hydrogens the extraction added: adding
    # them here rather than letting PDBFixer try is the whole point, since it has
    # no template for a ligand.
    for molecule in ligands or []:
        modeller.add(molecule.to_topology().to_openmm(),
                     molecule.conformers[0].to_openmm())
    if ligands:
        # openff's to_openmm() sets residue and chain ids as ints, while OpenMM's
        # own topologies use strings. PDBFile.writeFile(keepIds=True) then dies on
        # len(res.id). Normalising here rather than at the write site because the
        # mixed types would otherwise surface again at every downstream writer.
        for chain in modeller.topology.chains():
            chain.id = str(chain.id)
        for residue in modeller.topology.residues():
            residue.id = str(residue.id)
        ok(f"merged {len(ligands)} ligand(s) back into the system")
{% endif %}

    n_atoms = modeller.topology.getNumAtoms()
    ok(f"prepared: {n_atoms} atoms, {len(list(modeller.topology.residues()))} residues")

    prepared = OUTPUT / "prepared.pdb"
    with open(prepared, "w") as handle:
        app.PDBFile.writeFile(modeller.topology, modeller.positions, handle, keepIds=True)
    info(f"wrote {prepared.name}")
    return modeller


{% if ligand_names %}
# ---------------------------------------------------------------------------
#  1b. Ligands
# ---------------------------------------------------------------------------

LIGAND_RESIDUES = {{ ligand_names | tojson }}


def extract_ligands():
    """Recover each kept ligand as a fully specified molecule.

    A PDB HETATM record has elements and coordinates but no bond orders and no
    hydrogens, which is nowhere near enough to parameterise. The chemistry comes
    from the RCSB chemical definition bundled alongside; this transfers it onto
    the deposited coordinates:

        PDB coordinates  +  CCD bond orders  ->  add hydrogens  ->  OpenFF molecule

    Note `Chem.RemoveAllHs` rather than `RemoveHs` on the template: RemoveHs
    keeps hydrogens that define stereochemistry, which leaves the template with
    a different atom count from the PDB fragment and makes the substructure
    match fail with an unhelpful "No matching found".
    """
    from openff.toolkit import Molecule
    from rdkit import Chem
    from rdkit.Chem import AllChem

{% if cfg.ligand_charge_method in ('am1bcc', 'am1bccelf10') %}
    # AM1-BCC is run by AmberTools' `sqm`, which the OpenFF toolkit finds on
    # PATH rather than by import. If the environment is not activated, the
    # AmberTools wrapper silently does not register and the failure surfaces
    # minutes later as an opaque "no registered toolkits can provide
    # assign_partial_charges". Checked up front instead.
    import shutil
    if not shutil.which("sqm") or not shutil.which("antechamber"):
        fail("AmberTools is not on PATH, so AM1-BCC charges cannot be computed.")
        info("Run this bundle through its own environment: `pixi run python run.py`,")
        info("or just re-run the .command file, which does that for you.")
        sys.exit(1)
{% endif %}

    source = app.PDBFile(str(INPUT))
    molecules = []

    for resname in LIGAND_RESIDUES:
        template_path = HERE / "ligands" / f"{resname}.sdf"
        if not template_path.is_file():
            warn(f"no chemical definition bundled for {resname}; skipping it")
            continue

        present = [r for r in source.topology.residues() if r.name == resname]
        if not present:
            warn(f"{resname} is not in the structure; skipping it")
            continue

        for copy_index, residue in enumerate(present):
            keep = {a.index for a in residue.atoms()}
            fragment = app.Modeller(source.topology, source.positions)
            fragment.delete([a for a in fragment.topology.atoms() if a.index not in keep])

            block = io.StringIO()
            app.PDBFile.writeFile(fragment.topology, fragment.positions, block)
            rd = Chem.MolFromPDBBlock(block.getvalue(), removeHs=True)
            if rd is None:
                fail(f"{resname} could not be read out of the structure.")
                sys.exit(1)

            template = Chem.RemoveAllHs(Chem.MolFromMolFile(str(template_path)))
            if template is None:
                fail(f"the bundled chemical definition for {resname} is unreadable.")
                sys.exit(1)

            try:
                rd = AllChem.AssignBondOrdersFromTemplate(template, rd)
            except ValueError:
                fail(
                    f"{resname} in this structure does not match its RCSB chemical "
                    f"definition ({rd.GetNumAtoms()} atoms here, "
                    f"{template.GetNumAtoms()} in the definition)."
                )
                info("This usually means the ligand is partially resolved, covalently "
                     "bound, or a modified form. Rebuild the bundle without it.")
                sys.exit(1)

            rd = Chem.AddHs(rd, addCoords=True)

            # AddHs gives the new hydrogens no PDB residue metadata, so they end
            # up in a separate UNK residue everywhere downstream: `resname BEN`
            # then selects 9 atoms instead of 17, and a residue with zero heavy
            # atoms makes MDTraj's closest-heavy contact analysis fail outright.
            # Stamping the parent residue onto them keeps the ligand one entity.
            reference = next((a.GetPDBResidueInfo() for a in rd.GetAtoms()
                              if a.GetPDBResidueInfo() is not None), None)
            if reference is not None:
                counter = 0
                for atom in rd.GetAtoms():
                    if atom.GetPDBResidueInfo() is not None:
                        continue
                    counter += 1
                    stamp = Chem.AtomPDBResidueInfo()
                    stamp.SetResidueName(reference.GetResidueName())
                    stamp.SetResidueNumber(reference.GetResidueNumber())
                    stamp.SetChainId(reference.GetChainId())
                    stamp.SetIsHeteroAtom(True)
                    stamp.SetName(f"H{counter}".ljust(4)[:4])
                    atom.SetMonomerInfo(stamp)

            molecule = Molecule.from_rdkit(rd, allow_undefined_stereo=True)
            molecule.name = resname if len(present) == 1 else f"{resname}_{copy_index + 1}"
            molecules.append(molecule)

            info(f"{molecule.name}: {molecule.n_atoms} atoms, "
                 f"formal charge {molecule.total_charge.m:+.0f}, "
                 f"{molecule.to_smiles(explicit_hydrogens=False)}")

    if molecules:
        warn("ligand protonation comes from the RCSB chemical definition, not from "
             "the pH above -- check the formal charges printed here are the ones "
             "you expect at pH {{ cfg.ph }}.")
    return molecules
{% endif %}


