def build_forcefield(ligands=None):
    forcefield = app.ForceField({% for f in ff_files %}{{ f | tojson }}{{ ", " if not loop.last }}{% endfor %})
{% if ligand_names %}
    if ligands:
        from openmmforcefields.generators import {{ ligand_generator }}

        generator = {{ ligand_generator }}(
            molecules=ligands,
            forcefield={{ cfg.ligand_ff | tojson }},
        )
{% if cfg.ligand_charge_method == 'gasteiger' %}
        # Gasteiger charges are assigned up front so the generator uses them
        # instead of running AM1-BCC. Fast and noticeably worse -- the force
        # fields here were fitted against AM1-BCC.
        for molecule in ligands:
            molecule.assign_partial_charges("gasteiger")
        generator = {{ ligand_generator }}(
            molecules=ligands,
            forcefield={{ cfg.ligand_ff | tojson }},
        )
{% endif %}
        forcefield.registerTemplateGenerator(generator.generator)
        step("parameterising {{ ligand_names | length }} ligand type(s) with "
             "{{ cfg.ligand_ff }} -- this takes a minute or two per molecule")
{% endif %}
    return forcefield


def solvate(modeller, forcefield):
{% if cfg.solvent_mode == 'explicit' %}
{% if cfg.use_membrane %}
    warn("the protein must already be oriented with the membrane normal along z")
    spinner = Spinner("building a {{ cfg.lipid_type }} bilayer (packing lipids and solvent)")
    modeller.addMembrane(
        forcefield,
        lipidType={{ cfg.lipid_type | tojson }},
        membraneCenterZ={{ cfg.membrane_center_z }} * unit.nanometer,
        minimumPadding={{ cfg.membrane_padding }} * unit.nanometer,
        positiveIon={{ cfg.positive_ion | tojson }},
        negativeIon={{ cfg.negative_ion | tojson }},
        ionicStrength={{ cfg.ionic_strength }} * unit.molar,
        neutralize={{ 'True' if cfg.neutralize else 'False' }},
    )
{% else %}
    spinner = Spinner("solvating in a {{ cfg.box_shape }} box (packing water and ions)")
    # `model` selects the water GEOMETRY to pack; the parameters come from the
    # water XML loaded into the force field above. For OPC and the force-balance
    # models those are deliberately different names -- see WATER_MODEL_XML in
    # flexappeal/options.py for why.
    modeller.addSolvent(
        forcefield,
        model={{ water_geometry | tojson }},
{% if cfg.box_sizing == 'padding' %}
        padding={{ cfg.padding }} * unit.nanometer,
        boxShape={{ cfg.box_shape | tojson }},
{% elif cfg.box_sizing == 'vectors' %}
        boxSize=openmm.Vec3({{ box_vectors[0] }}, {{ box_vectors[1] }}, {{ box_vectors[2] }}) * unit.nanometer,
{% else %}
        numAdded={{ cfg.num_waters }},
        boxShape={{ cfg.box_shape | tojson }},
{% endif %}
        positiveIon={{ cfg.positive_ion | tojson }},
        negativeIon={{ cfg.negative_ion | tojson }},
        ionicStrength={{ cfg.ionic_strength }} * unit.molar,
        neutralize={{ 'True' if cfg.neutralize else 'False' }},
    )
{% endif %}
    n = modeller.topology.getNumAtoms()
    waters = sum(1 for r in modeller.topology.residues() if r.name in ("HOH", "WAT"))
    spinner.close(f"solvated: {n} atoms, {waters} waters")

    solvated = OUTPUT / "solvated.pdb"
{% if cfg.save_solvated_pdb %}
    with open(solvated, "w") as handle:
        app.PDBFile.writeFile(modeller.topology, modeller.positions, handle, keepIds=True)
    info(f"wrote {solvated.name}")
{% endif %}
{% else %}
    info("no explicit solvent ({{ cfg.solvent_mode }})")
{% endif %}
    return modeller


