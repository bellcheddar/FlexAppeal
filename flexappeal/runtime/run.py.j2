_TTY = sys.stdout.isatty()
def _c(code, text):
    return f"\033[{code}m{text}\033[0m" if _TTY else text

def info(msg):  print(_c("38;2;30;115;190", "ℹ"), msg, flush=True)
def ok(msg):    print(_c("38;2;0;208;132", "✓"), msg, flush=True)
def step(msg):  print(_c("38;2;30;115;190", "→"), msg, flush=True)
def warn(msg):  print(_c("38;2;252;185;0", "⚠"), msg, flush=True)
def fail(msg):  print(_c("38;2;214;54;56", "✗"), msg, file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
#  Progress
# ---------------------------------------------------------------------------
#
# Several stages here are long and silent -- solvating a large box, minimising,
# and the equilibration before production. A run that prints nothing for four
# minutes is indistinguishable from a run that has hung, so every stage now
# reports.
#
# Two shapes, because the work comes in two shapes. Anything whose length is
# known in advance (integration steps, a bounded minimisation) gets a bar with
# a percentage and an estimate. Anything that blocks inside OpenMM with no
# callback to hook -- addSolvent, addMembrane, createSystem -- gets a spinner
# on a background thread, which at least distinguishes "working" from "stuck".
#
# Both degrade when stdout is not a terminal. Redrawing with \r into a log file
# produces an unreadable single line several megabytes long, so a non-terminal
# gets periodic milestones instead.

_BAR_WIDTH = 26
_LOG_EVERY_SECONDS = 20


def _fmt_duration(seconds):
    if seconds is None or seconds != seconds or seconds < 0:
        return "--"
    seconds = int(seconds)
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def _clear_line():
    if _TTY:
        sys.stdout.write("\r\033[2K")
        sys.stdout.flush()


class Progress:
    """A bar for work whose total is known up front."""

    def __init__(self, total, label):
        self.total = max(1, int(total))
        self.label = label
        self.started = time.time()
        self._last_draw = 0.0
        self._last_logged = -1

    def update(self, done, extra=""):
        done = max(0, min(int(done), self.total))
        fraction = done / self.total
        now = time.time()
        elapsed = now - self.started

        if _TTY:
            # Ten redraws a second is plenty and keeps the cost off the hot loop.
            if now - self._last_draw < 0.1 and done < self.total:
                return
            self._last_draw = now
            filled = int(round(_BAR_WIDTH * fraction))
            bar = "━" * filled + _c("38;2;70;80;95", "━" * (_BAR_WIDTH - filled))
            eta = (elapsed / fraction - elapsed) if fraction > 0.02 else None
            sys.stdout.write(
                f"\r  {_c('38;2;30;115;190', bar)} {fraction * 100:5.1f}%  "
                f"{self.label}{extra}  {_fmt_duration(elapsed)}"
                + (f" / eta {_fmt_duration(eta)}" if eta else "")
                + "\033[K"
            )
            sys.stdout.flush()
        else:
            # A log gets a line per elapsed interval, not per update.
            bucket = int(elapsed // _LOG_EVERY_SECONDS)
            if bucket > self._last_logged:
                self._last_logged = bucket
                print(f"  {self.label}: {fraction * 100:.0f}%{extra} "
                      f"({_fmt_duration(elapsed)})", flush=True)

    def close(self, message=""):
        _clear_line()
        if message:
            ok(f"{message}  {_c('2', _fmt_duration(time.time() - self.started))}")


class Spinner:
    """An indeterminate ticker for a blocking call with no progress callback.

    Used as a context manager. On a terminal a daemon thread animates it while
    the main thread does the work; elsewhere it prints one line on entry and
    one on exit, so a log still shows the stage and how long it took.
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, label):
        self.label = label
        self.started = time.time()
        self._stop = threading.Event()
        self._thread = None

    def __enter__(self):
        step(self.label)
        if _TTY:
            self._thread = threading.Thread(target=self._spin, daemon=True)
            self._thread.start()
        return self

    def _spin(self):
        frame = 0
        while not self._stop.wait(0.12):
            elapsed = _fmt_duration(time.time() - self.started)
            sys.stdout.write(
                f"\r  {_c('38;2;30;115;190', self.FRAMES[frame % len(self.FRAMES)])} "
                f"{self.label}  {_c('2', elapsed)}\033[K")
            sys.stdout.flush()
            frame += 1

    def __exit__(self, *exc):
        self._stop.set()
        if self._thread:
            self._thread.join(timeout=1)
        _clear_line()
        return False

    def close(self, message):
        self.__exit__()
        ok(f"{message}  {_c('2', _fmt_duration(time.time() - self.started))}")


class MinimisationProgress(openmm.MinimizationReporter):
    """Liveness and the falling energy during minimizeEnergy, which is silent.

    OpenMM calls report(iteration, x, grad, args) and stops early if it returns
    True. Note the four arguments: Python's introspection of the base class
    reports three, and a three-argument override fails with a TypeError.

    Deliberately not a percentage bar. The `iteration` argument is not
    monotonic -- the L-BFGS minimiser restarts, so it climbs, resets to zero and
    climbs again (measured: 1530 calls, three resets, a final value of 29 after
    peaking at 499). A bar driven by it runs backwards, and the total work is
    not knowable in advance. What is meaningful is the energy coming down, so
    that is what this shows, next to a count of the iterations actually done.
    """

    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, label, _unused_total=0):
        super().__init__()
        self.label = label
        self.started = time.time()
        self.iterations = 0
        self.energy = None
        self._last = 0.0
        self._frame = 0

    def report(self, iteration, x, grad, args):
        self.iterations += 1          # counted, not taken from a resetting argument
        # `args` is OpenMM's mapstringdouble, which supports subscripting but has
        # no .get(). Guarding with hasattr(args, "get") therefore skipped the
        # energy silently on every call and the display came out blank.
        try:
            self.energy = args["system energy"]
        except (KeyError, TypeError):
            pass

        now = time.time()
        detail = f"{self.energy:,.0f} kJ/mol" if self.energy is not None else ""

        if _TTY:
            if now - self._last < 0.1:
                return False
            self._last = now
            self._frame += 1
            sys.stdout.write(
                f"\r  {_c('38;2;30;115;190', self.FRAMES[self._frame % len(self.FRAMES)])} "
                f"{self.label}  {detail}  "
                f"{_c('2', f'{self.iterations:,} iterations · ' + _fmt_duration(now - self.started))}"
                f"\033[K")
            sys.stdout.flush()
        elif now - self._last >= _LOG_EVERY_SECONDS:
            self._last = now
            print(f"  {self.label}: {detail} after {self.iterations:,} iterations "
                  f"({_fmt_duration(now - self.started)})", flush=True)
        return False

    def close(self, message):
        _clear_line()
        ok(f"{message}  {_c('2', _fmt_duration(time.time() - self.started))}")


def run_chunked(simulation, steps, bar, offset, extra=lambda: ""):
    """Integrate `steps`, driving a bar that spans several calls.

    Heating and equilibration are staged -- a temperature ramp, a restraint
    release schedule -- but a bar per stage would flicker through five in a row
    and tell the reader nothing about the whole. One bar, advanced by `offset`,
    reads as the single operation it is.
    """
    chunk = max(100, steps // 50)
    done = 0
    while done < steps:
        n = min(chunk, steps - done)
        simulation.step(n)
        done += n
        bar.update(offset + done, extra())


def run_steps(simulation, total, label, extra=lambda: ""):
    """Integrate `total` steps, updating a bar as it goes.

    Stepping in chunks rather than one call so there is something to report.
    The chunk is a percent of the run, floored at 100 steps, which keeps the
    per-call overhead irrelevant next to the integration itself.
    """
    if total <= 0:
        return
    bar = Progress(total, label)
    chunk = max(100, total // 100)
    done = 0
    while done < total:
        n = min(chunk, total - done)
        simulation.step(n)
        done += n
        bar.update(done, extra())
    bar.close()
    return bar


# ---------------------------------------------------------------------------
#  Atom selection
# ---------------------------------------------------------------------------

# Standard residue names, including the protonation-state variants both AMBER
# and CHARMM use. Kept explicit rather than inferred: OpenMM's Topology has no
# concept of "is this protein", and guessing from connectivity is worse.
_PROTEIN_RESIDUES = {
    "ALA", "ARG", "ASN", "ASP", "CYS", "GLN", "GLU", "GLY", "HIS", "ILE",
    "LEU", "LYS", "MET", "PHE", "PRO", "SER", "THR", "TRP", "TYR", "VAL",
    "HID", "HIE", "HIP", "HSD", "HSE", "HSP", "CYX", "CYM", "ASH", "GLH",
    "LYN", "ACE", "NME", "NMA", "SEC", "PYL",
}
_SOLVENT_RESIDUES = {
    "HOH", "WAT", "TIP3", "TIP4", "SOL", "NA", "CL", "K", "MG", "CA", "ZN",
    "LI", "RB", "CS", "BR", "F", "IOD", "SOD", "CLA", "POT",
}
# Both spellings on purpose. A PDB residue name field is three characters, so a
# four-character lipid is truncated the moment anything is written or read as
# PDB: POPC becomes POP, DPPC becomes DPP. Matching only the full name means
# every lipid silently fails to match and the whole bilayer lands in selections
# meant to exclude it.
_LIPID_RESIDUES = {
    "POPC", "POPE", "DLPC", "DLPE", "DMPC", "DOPC", "DPPC",
    "POP", "DLP", "DMP", "DOP", "DPP",
}


def select_atoms(topology, selection):
    """Atom indices for a named selection. Returns None for 'everything'."""
    if selection == "all":
        return None

    indices = []
    for atom in topology.atoms():
        name = atom.residue.name
        is_protein = name in _PROTEIN_RESIDUES
        is_solvent = name in _SOLVENT_RESIDUES
        is_lipid = name in _LIPID_RESIDUES
        is_hydrogen = atom.element is not None and atom.element.symbol == "H"

        if selection == "protein":
            keep = is_protein
        elif selection == "protein_heavy":
            keep = is_protein and not is_hydrogen
        elif selection == "backbone":
            keep = is_protein and atom.name in ("N", "CA", "C", "O")
        elif selection == "ca":
            keep = is_protein and atom.name == "CA"
        elif selection == "protein_ligand":
            keep = not is_solvent and not is_lipid
        else:
            raise ValueError(f"unknown selection {selection!r}")

        if keep:
            indices.append(atom.index)
    return indices


