{% if cfg.memory_guard %}
def check_memory(n_atoms):
    """Refuse to start if the run would push the machine into swap.

    Swapping during molecular dynamics does not merely slow a run down -- it can
    turn hours into days, because every step touches the whole coordinate array.
    The estimate is deliberately crude and generous; it exists to catch the
    order-of-magnitude mistake, not to predict usage.
    """
    try:
        total = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
    except (ValueError, OSError, AttributeError):
        return  # Unknown platform: say nothing rather than guess.

    estimated = 1.5e9 + n_atoms * 2500      # baseline + per-atom working set
    if estimated > total * 0.8:
        fail(
            f"this system needs roughly {estimated / 1e9:.1f} GB but the machine has "
            f"{total / 1e9:.1f} GB. Running it would swap, which can turn a "
            f"several-hour job into a several-day one."
        )
        info("Reduce the system: fewer chains, less padding, or an octahedral box.")
        sys.exit(1)
    elif estimated > total * 0.5:
        warn(
            f"estimated memory {estimated / 1e9:.1f} GB of {total / 1e9:.1f} GB total. "
            f"Close other applications before leaving this running."
        )
{% endif %}


