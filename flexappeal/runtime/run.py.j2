def build_system(topology, forcefield):
    spinner = Spinner("building the system (assigning parameters to every atom)")
    system = forcefield.createSystem(
        topology,
        nonbondedMethod=app.{{ cfg.nonbonded_method }},
{% if cfg.nonbonded_method != 'NoCutoff' %}
        nonbondedCutoff={{ cfg.nonbonded_cutoff }} * unit.nanometer,
{% endif %}
        constraints={{ 'None' if cfg.constraints == 'None' else 'app.' + cfg.constraints }},
{% if cfg.solvent_mode == 'explicit' %}
        rigidWater={{ 'True' if cfg.rigid_water else 'False' }},
{% endif %}
        removeCMMotion={{ 'True' if cfg.remove_cm_motion else 'False' }},
{% if cfg.use_hmr %}
        # Hydrogen mass repartitioning: mass moves from heavy atoms onto their
        # hydrogens, slowing the fastest remaining motions so the timestep can
        # be {{ cfg.timestep }} fs instead of 2. Total mass is unchanged.
        hydrogenMass={{ cfg.hydrogen_mass }} * unit.amu,
{% endif %}
{% if cfg.use_switching %}
        switchDistance={{ cfg.switch_distance }} * unit.nanometer,
{% endif %}
{% if cfg.flexible_constraints is defined and cfg.flexible_constraints %}
        flexibleConstraints=True,
{% endif %}
{% if cfg.solvent_mode == 'implicit' %}
        implicitSolvent=app.{{ implicit_symbol }},
        implicitSolventSaltConc={{ cfg.implicit_salt }} * unit.moles / unit.liter,
        soluteDielectric={{ cfg.solute_dielectric }},
        solventDielectric={{ cfg.solvent_dielectric }},
{% endif %}
    )

{% if cfg.nonbonded_method in ('PME', 'LJPME', 'Ewald') %}
    for force in system.getForces():
        if isinstance(force, openmm.NonbondedForce):
            force.setEwaldErrorTolerance({{ cfg.ewald_error_tolerance }})
            force.setUseDispersionCorrection({{ 'True' if cfg.dispersion_correction else 'False' }})
{% endif %}

{% if cfg.barostat == 'MonteCarlo' %}
    system.addForce(openmm.MonteCarloBarostat(
        {{ cfg.pressure }} * unit.bar, {{ cfg.temperature }} * unit.kelvin, {{ cfg.barostat_frequency }}))
{% elif cfg.barostat == 'MonteCarloMembrane' %}
    # Membrane barostat: scales the bilayer plane and the normal separately. A
    # tensionless membrane (surface tension 0) is what the CHARMM36 lipid
    # parameters were fitted to reproduce.
    system.addForce(openmm.MonteCarloMembraneBarostat(
        {{ cfg.pressure }} * unit.bar,
        {{ cfg.surface_tension }} * unit.bar * unit.nanometer,
        {{ cfg.temperature }} * unit.kelvin,
        openmm.MonteCarloMembraneBarostat.{{ cfg.membrane_xymode }},
        openmm.MonteCarloMembraneBarostat.{{ cfg.membrane_zmode }},
        {{ cfg.barostat_frequency }}))
{% elif cfg.barostat == 'MonteCarloAnisotropic' %}
    system.addForce(openmm.MonteCarloAnisotropicBarostat(
        openmm.Vec3({{ anisotropic_pressure[0] }}, {{ anisotropic_pressure[1] }}, {{ anisotropic_pressure[2] }}) * unit.bar,
        {{ cfg.temperature }} * unit.kelvin,
        True, True, True, {{ cfg.barostat_frequency }}))
{% elif cfg.barostat == 'MonteCarloFlexible' %}
    system.addForce(openmm.MonteCarloFlexibleBarostat(
        {{ cfg.pressure }} * unit.bar, {{ cfg.temperature }} * unit.kelvin, {{ cfg.barostat_frequency }}))
{% endif %}
{% if cfg.use_thermostat %}
    system.addForce(openmm.AndersenThermostat(
        {{ cfg.temperature }} * unit.kelvin, {{ cfg.collision_frequency }} / unit.picosecond))
{% endif %}

    spinner.close(f"system: {system.getNumParticles()} particles, "
                  f"{system.getNumConstraints()} constraints, "
                  f"{system.getNumForces()} forces")
    return system


{% if cfg.use_positional_restraints %}
def add_restraints(system, topology, positions):
    """Positional restraints, released in stages before production.

    Holds the solute near its starting coordinates while freshly added water
    relaxes around it. `periodicdistance` rather than a plain distance so an
    atom that drifts across a periodic boundary is not yanked across the box.
    """
    restraint = openmm.CustomExternalForce(
        "k_restraint*periodicdistance(x, y, z, x0, y0, z0)^2")
    restraint.addGlobalParameter(
        "k_restraint", {{ cfg.restraint_force }} * unit.kilojoules_per_mole / unit.nanometer**2)
    restraint.addPerParticleParameter("x0")
    restraint.addPerParticleParameter("y0")
    restraint.addPerParticleParameter("z0")

    indices = select_atoms(topology, {{ cfg.restraint_selection | tojson }})
    for index in indices:
        restraint.addParticle(index, positions[index].value_in_unit(unit.nanometer))
    system.addForce(restraint)
    info(f"restrained {len(indices)} atoms at {{ cfg.restraint_force }} kJ/mol/nm²")
    return restraint
{% endif %}


# ---------------------------------------------------------------------------
#  4. Platform
# ---------------------------------------------------------------------------

def usable_properties(plat, wanted):
    """Drop properties this platform will not accept, rather than losing it.

    Apple's OpenCL implements single precision only. Asking it for `mixed` --
    the right default on CUDA, and so the default here -- makes context
    creation fail with "No compatible OpenCL platform is available", which
    names the platform rather than the property and reads as "you have no GPU".
    The benchmark then quietly falls back to CPU.

    That was costing an order of magnitude on this hardware: measured on
    solvated lysozyme (19,616 atoms) on an M1 Max, CPU 30.8 ns/day against
    OpenCL 301.1 ns/day. A ten-nanosecond run took eight hours instead of
    fifty minutes, and nothing in the output suggested anything was wrong.

    So a property the platform rejects is degraded, not fatal, and the
    substitution is announced -- silently running at a different precision than
    asked for would be worse than the original bug.
    """
    supported = set(plat.getPropertyNames())
    usable = {}
    for key, value in wanted.items():
        if key not in supported:
            continue
        if key == "Precision" and value == "mixed" and plat.getName() == "OpenCL":
            # Probe rather than hard-code a platform list: a future build may
            # well support it, and this asks the implementation in front of us.
            if not _supports_mixed(plat):
                warn(f"{plat.getName()} does not support mixed precision here; using single")
                value = "single"
        usable[key] = value
    return usable


def _supports_mixed(plat):
    """Can this platform build a trivial context at mixed precision?"""
    try:
        probe = openmm.System()
        probe.addParticle(1.0)
        openmm.Context(probe, openmm.VerletIntegrator(0.001), plat, {"Precision": "mixed"})
        return True
    except Exception:
        return False


def platform_properties(name):
    properties = {}
{% if cfg.precision %}
    if name in ("CUDA", "OpenCL", "HIP", "Metal"):
        properties["Precision"] = {{ cfg.precision | tojson }}
{% endif %}
{% if cfg.cpu_threads %}
    if name == "CPU":
        properties["Threads"] = "{{ cfg.cpu_threads }}"
{% endif %}
{% if cfg.deterministic_forces %}
    if name in ("CUDA", "CPU"):
        properties["DeterministicForces"] = "true"
{% endif %}
{% if cfg.device_index %}
    if name in ("CUDA", "OpenCL", "HIP"):
        properties["DeviceIndex"] = {{ cfg.device_index | tojson }}
{% endif %}
    return usable_properties(openmm.Platform.getPlatformByName(name), properties)


def available_platforms():
    return [openmm.Platform.getPlatform(i).getName()
            for i in range(openmm.Platform.getNumPlatforms())]


def relax(system, positions):
    """A short minimisation to remove the clashes solvation leaves behind.

    Necessary before benchmarking: addSolvent packs water without regard to
    overlap, so integrating even a few steps from those raw coordinates sends a
    particle to NaN and every platform "fails" for reasons that have nothing to
    do with the platform. The relaxed positions are reused for the real run, so
    this work is not thrown away.
    """
    integrator = openmm.VerletIntegrator(0.001 * unit.picoseconds)
    context = openmm.Context(system, integrator)
    context.setPositions(positions)
    reporter = MinimisationProgress("relaxing initial clashes", 200)
    openmm.LocalEnergyMinimizer.minimize(context, 100.0, 200, reporter)
    reporter.close("clashes relaxed")
    relaxed = context.getState(getPositions=True).getPositions()
    del context, integrator
    return relaxed


def select_platform(system, topology, positions):
    """Choose a compute platform, benchmarking when asked to.

    OpenMM has no official Metal back end, and Apple has deprecated OpenCL
    (though it still works on M-series hardware, when the build's ICD loader can
    see it). Rather than assume which is faster on this machine, run a few
    hundred real steps on each and measure. It costs under a minute and is more
    reliable than guessing.
    """
    available = available_platforms()
    info(f"platforms available: {', '.join(available)}")

{% if cfg.platform != 'auto' %}
    if {{ cfg.platform | tojson }} not in available:
        fail("{{ cfg.platform }} is not available in this OpenMM build.")
        info(f"Available: {', '.join(available)}. Rebuild the bundle choosing one of these.")
        sys.exit(1)
    chosen = openmm.Platform.getPlatformByName({{ cfg.platform | tojson }})
    return chosen, platform_properties({{ cfg.platform | tojson }}), None
{% else %}
    # Reference is excluded: it is the unoptimised implementation and is roughly
    # a hundred times slower than CPU. It would never win, and benchmarking it
    # wastes the user's time.
    candidates = [p for p in available if p != "Reference"]
    if not candidates:
        candidates = available

    if len(candidates) == 1:
        name = candidates[0]
        info(f"only one platform available: {name}")
        return openmm.Platform.getPlatformByName(name), platform_properties(name), None

    step(f"benchmarking {len(candidates)} platforms ({', '.join(candidates)})")
    results = {}
    for name in candidates:
        try:
            plat = openmm.Platform.getPlatformByName(name)
            integrator = openmm.LangevinMiddleIntegrator(
                {{ cfg.temperature }} * unit.kelvin,
                {{ cfg.friction }} / unit.picosecond,
                {{ cfg.timestep }} * unit.femtoseconds)
            context = openmm.Context(system, integrator, plat, platform_properties(name))
            context.setPositions(positions)
            context.setVelocitiesToTemperature({{ cfg.temperature }} * unit.kelvin)
            integrator.step(20)             # warm up: JIT, buffers, neighbour list
            start = time.time()
            integrator.step(200)
            context.getState(getEnergy=True)   # force synchronisation before timing
            elapsed = time.time() - start
            ns_per_day = (200 * {{ derived.timestep_ps }} / 1000.0) / (elapsed / 86400.0)
            results[name] = ns_per_day
            info(f"  {name:10s} {ns_per_day:8.1f} ns/day")
            del context, integrator
        except Exception as exc:
            warn(f"  {name:10s} unavailable: {exc}")

    if not results:
        fail("no platform could run this system.")
        info("If every platform reported NaN, the system has a problem that "
             "minimisation cannot fix -- check prepared.pdb and solvated.pdb.")
        sys.exit(1)

    best = max(results, key=results.get)
    ok(f"using {best} at {results[best]:.1f} ns/day")
    return openmm.Platform.getPlatformByName(best), platform_properties(best), results[best]
{% endif %}


def build_integrator(seed_offset=0):
{% if cfg.integrator in ('LangevinMiddle', 'Langevin') %}
    integrator = openmm.{{ cfg.integrator }}Integrator(
        {{ cfg.temperature }} * unit.kelvin,
        {{ cfg.friction }} / unit.picosecond,
        {{ cfg.timestep }} * unit.femtoseconds)
{% elif cfg.integrator == 'NoseHoover' %}
    integrator = openmm.NoseHooverIntegrator(
        {{ cfg.temperature }} * unit.kelvin,
        {{ cfg.friction }} / unit.picosecond,
        {{ cfg.timestep }} * unit.femtoseconds)
{% elif cfg.integrator == 'Verlet' %}
    integrator = openmm.VerletIntegrator({{ cfg.timestep }} * unit.femtoseconds)
{% elif cfg.integrator == 'Brownian' %}
    integrator = openmm.BrownianIntegrator(
        {{ cfg.temperature }} * unit.kelvin,
        {{ cfg.friction }} / unit.picosecond,
        {{ cfg.timestep }} * unit.femtoseconds)
{% elif cfg.integrator == 'VariableLangevin' %}
    integrator = openmm.VariableLangevinIntegrator(
        {{ cfg.temperature }} * unit.kelvin,
        {{ cfg.friction }} / unit.picosecond,
        {{ cfg.error_tolerance }})
{% elif cfg.integrator == 'VariableVerlet' %}
    integrator = openmm.VariableVerletIntegrator({{ cfg.error_tolerance }})
{% endif %}
{% if cfg.random_seed %}
    integrator.setRandomNumberSeed({{ cfg.random_seed }} + seed_offset)
{% endif %}
    return integrator


# ---------------------------------------------------------------------------
#  5. Simulate
# ---------------------------------------------------------------------------

def simulate(replicate, modeller, forcefield, system, plat, properties, benchmark):
    """Run one replicate.

    Wrapped so OpenMM's NaN exception -- which can surface from any step() call
    and arrives as a bare traceback through its internals -- is turned into a
    diagnosis naming the stage and the likely cause.
    """
    try:
        return _simulate(replicate, modeller, forcefield, system, plat,
                         properties, benchmark)
    except openmm.OpenMMException as exc:
        if "NaN" not in str(exc):
            raise
        explain_instability(CURRENT_STAGE[0])
        sys.exit(1)


CURRENT_STAGE = ["the run"]


def _simulate(replicate, modeller, forcefield, system, plat, properties, benchmark):
    suffix = f"_rep{replicate}" if {{ derived.replicates }} > 1 else ""
    run_dir = OUTPUT / f"{JOB_NAME}{suffix}"
    run_dir.mkdir(parents=True, exist_ok=True)

    integrator = build_integrator(seed_offset=replicate)
    simulation = app.Simulation(modeller.topology, system, integrator, plat, properties)
    simulation.context.setPositions(modeller.positions)

    checkpoint = run_dir / "state.chk"
    resumed = False
    if checkpoint.is_file():
        try:
            simulation.loadCheckpoint(str(checkpoint))
            resumed = True
            done = simulation.context.getState().getStepCount()
            ok(f"resumed from checkpoint at step {done}")
        except Exception as exc:
            warn(f"checkpoint could not be loaded ({exc}); starting again")

    if not resumed:
{% if cfg.minimize %}
        CURRENT_STAGE[0] = "minimisation"
        before = simulation.context.getState(getEnergy=True).getPotentialEnergy()
        reporter = MinimisationProgress("minimising")
        simulation.minimizeEnergy(
            tolerance={{ cfg.minimize_tolerance }} * unit.kilojoule_per_mole / unit.nanometer,
{% if cfg.minimize_max_iterations %}
            maxIterations={{ cfg.minimize_max_iterations }},
{% endif %}
            reporter=reporter,
        )
        after = simulation.context.getState(getEnergy=True).getPotentialEnergy()
        reporter.close(
            f"minimised over {reporter.iterations:,} iterations: "
            f"{before.value_in_unit(unit.kilojoule_per_mole):,.0f} → "
            f"{after.value_in_unit(unit.kilojoule_per_mole):,.0f} kJ/mol")
        check_stable(simulation, "minimisation")
        with open(run_dir / "minimised.pdb", "w") as handle:
            state = simulation.context.getState(getPositions=True)
            app.PDBFile.writeFile(simulation.topology, state.getPositions(), handle, keepIds=True)
{% endif %}

{% if derived.heat_steps %}
        step("heating {{ cfg.heat_start_temp }} → {{ cfg.temperature }} K over {{ cfg.heat_duration }} ps")
        simulation.context.setVelocitiesToTemperature({{ cfg.heat_start_temp }} * unit.kelvin)
        CURRENT_STAGE[0] = "heating"
        stages = {{ cfg.heat_stages }}
        per_stage = max(1, {{ derived.heat_steps }} // stages)
        bar = Progress(per_stage * stages, "heating")
        for i in range(stages):
            target = {{ cfg.heat_start_temp }} + ({{ cfg.temperature }} - {{ cfg.heat_start_temp }}) * (i + 1) / stages
            integrator.setTemperature(target * unit.kelvin)
            run_chunked(simulation, per_stage, bar, i * per_stage,
                        lambda t=target: f"  {t:.0f} K")
        bar.close("heated to {{ cfg.temperature }} K")
        check_stable(simulation, "heating")
{% else %}
        simulation.context.setVelocitiesToTemperature({{ cfg.temperature }} * unit.kelvin)
{% endif %}

{% if derived.equilibration_steps %}
        step("equilibrating for {{ cfg.equilibration_duration }} ps")
{% if cfg.use_positional_restraints %}
        # Release the restraints in stages so the structure adapts gradually
        # rather than being let go all at once.
        CURRENT_STAGE[0] = "equilibration"
        schedule = {{ restraint_schedule | tojson }}
        per_stage = max(1, {{ derived.equilibration_steps }} // len(schedule))
        bar = Progress(per_stage * len(schedule), "equilibrating")
        for i, k in enumerate(schedule):
            simulation.context.setParameter(
                "k_restraint", k * unit.kilojoules_per_mole / unit.nanometer**2)
            run_chunked(simulation, per_stage, bar, i * per_stage,
                        lambda k=k: f"  restraint {k:g} kJ/mol/nm²")
        bar.close("equilibrated")
        check_stable(simulation, "equilibration")
{% else %}
        run_steps(simulation, {{ derived.equilibration_steps }}, "equilibrating")
        ok("equilibrated")
{% endif %}
{% endif %}
        simulation.saveCheckpoint(str(checkpoint))

    # ----- production -----
    production_steps = {{ derived.production_steps }}
    done = simulation.context.getState().getStepCount()
    remaining = max(0, production_steps - max(0, done - {{ derived.heat_steps + derived.equilibration_steps }}))
    if remaining <= 0:
        ok("production already complete")
        return run_dir

    subset = select_atoms(simulation.topology, {{ traj_selection | tojson }})
    traj_path = run_dir / "trajectory.{{ traj_extension }}"

{% if cfg.traj_format == 'xtc' %}
    simulation.reporters.append(app.XTCReporter(
        str(traj_path), {{ derived.traj_interval_steps }}, append=traj_path.is_file(),
        enforcePeriodicBox={{ 'True' if cfg.enforce_periodic_box else 'False' }}, atomSubset=subset))
{% elif cfg.traj_format == 'dcd' %}
    simulation.reporters.append(app.DCDReporter(
        str(traj_path), {{ derived.traj_interval_steps }}, append=traj_path.is_file(),
        enforcePeriodicBox={{ 'True' if cfg.enforce_periodic_box else 'False' }}, atomSubset=subset))
{% else %}
    simulation.reporters.append(HDF5Reporter(
        str(traj_path), {{ derived.traj_interval_steps }}, atomSubset=subset,
        enforcePeriodicBox={{ 'True' if cfg.enforce_periodic_box else 'False' }}))
{% endif %}

    # StateDataReporter's `progress` and `remainingTime` are computed from the
    # simulation's absolute step counter, which already includes heating and
    # equilibration. Passing the production count alone makes progress run past
    # 100% and the ETA wrap around, so totalSteps has to be the absolute figure.
    start_step = simulation.context.getState().getStepCount()
    total_steps = start_step + remaining

    simulation.reporters.append(app.StateDataReporter(
        str(run_dir / "state_data.csv"), {{ derived.state_interval_steps }},
        totalSteps=total_steps, separator=",",
{% for f in cfg.state_fields %}
        {{ f }}=True,
{% endfor %}
    ))
    # No StateDataReporter to stdout: it prints a fresh row every interval, which
    # scrolls the terminal for hours and buries everything else. The bar below
    # carries the same information -- progress, speed, time remaining -- on one
    # line, and the full series is in state_data.csv either way.
    simulation.reporters.append(app.CheckpointReporter(
        str(checkpoint), {{ derived.checkpoint_interval_steps }}))

    # The topology written here is subset-matched to the trajectory, so the
    # analysis step never has to guess which atoms the frames contain.
    with open(run_dir / "topology.pdb", "w") as handle:
        state = simulation.context.getState(getPositions=True)
        if subset is None:
            app.PDBFile.writeFile(simulation.topology, state.getPositions(), handle, keepIds=True)
        else:
            sub = app.Modeller(simulation.topology, state.getPositions())
            keep = set(subset)
            sub.delete([a for a in sub.topology.atoms() if a.index not in keep])
            app.PDBFile.writeFile(sub.topology, sub.positions, handle, keepIds=True)

    CURRENT_STAGE[0] = "production"
    step(f"producing {{ cfg.production_duration }} ns ({remaining:,} steps)")
    started = time.time()

    def throughput():
        elapsed = time.time() - started
        if elapsed < 1:
            return ""
        state = simulation.context.getState()
        done = state.getStepCount() - start_step
        ns_per_day = (done * {{ derived.timestep_ps }} / 1000.0) / (elapsed / 86400.0)
        return f"  {ns_per_day:.0f} ns/day"

    run_steps(simulation, remaining, "producing", throughput)
    elapsed = time.time() - started
    simulation.saveCheckpoint(str(checkpoint))

    achieved = (remaining * {{ derived.timestep_ps }} / 1000.0) / (elapsed / 86400.0)
    ok(f"production complete in {elapsed / 3600:.2f} h ({achieved:.1f} ns/day)")

{% if cfg.save_system_xml %}
    # Full serialisation: this is what makes the run reproducible and lets it be
    # extended later on different hardware without rebuilding anything.
    (run_dir / "system.xml").write_text(openmm.XmlSerializer.serialize(system))
    (run_dir / "integrator.xml").write_text(openmm.XmlSerializer.serialize(integrator))
    state = simulation.context.getState(getPositions=True, getVelocities=True)
    (run_dir / "final_state.xml").write_text(openmm.XmlSerializer.serialize(state))
{% endif %}

    (run_dir / "run_manifest.json").write_text(json.dumps({
        "job_name": JOB_NAME,
        "replicate": replicate,
        "flexappeal_version": FLEXAPPEAL_VERSION,
        "openmm_version": openmm.version.version,
        "platform": plat.getName(),
        "platform_properties": properties,
        "benchmark_ns_per_day": benchmark,
        "achieved_ns_per_day": round(achieved, 2),
        "wall_seconds": round(elapsed, 1),
        "production_steps": production_steps,
        "timestep_ps": {{ derived.timestep_ps }},
        "trajectory": traj_path.name,
        "trajectory_atoms": len(subset) if subset is not None else simulation.topology.getNumAtoms(),
        "total_atoms": simulation.topology.getNumAtoms(),
        "machine": {
            "system": platform.system(),
            "release": platform.release(),
            "machine": platform.machine(),
            "processor": platform.processor(),
            "python": platform.python_version(),
        },
        "finished_at": datetime.now(timezone.utc).isoformat(),
    }, indent=2))
    return run_dir


# ---------------------------------------------------------------------------
#  main
# ---------------------------------------------------------------------------

def main():
    global _SWAP_AT_START
    started_at = time.time()

    # Baseline the swap counter before anything allocates, so watch_swap()
    # reports what THIS run caused rather than what was already there.
    try:
        _SWAP_AT_START = psutil.swap_memory().used
    except Exception:
        _SWAP_AT_START = None

    console.print()
    console.print(Panel(
        f"[heading]{JOB_NAME}[/heading]\n"
        f"[muted]{{ summary_line }}[/muted]\n\n"
        f"[muted]FlexAppeal[/muted] {FLEXAPPEAL_VERSION}   "
        f"[muted]OpenMM[/muted] {openmm.version.version}   "
        f"[muted]{platform.machine()}[/muted] "
        f"[muted]\u00b7 {psutil.cpu_count(logical=False) or '?'} cores "
        f"\u00b7 {_human_bytes(psutil.virtual_memory().total)} RAM[/muted]",
        border_style="info", expand=False, padding=(0, 2)))
    console.print()

    OUTPUT.mkdir(parents=True, exist_ok=True)
    if not INPUT.is_file():
        fail(f"the bundled structure {INPUT.name} is missing. Re-extract the bundle.")
        return 1

{% if ligand_names %}
    ligands = extract_ligands()
{% else %}
    ligands = None
{% endif %}
    modeller = prepare_structure(ligands)
    forcefield = build_forcefield(ligands)
    modeller = solvate(modeller, forcefield)

{% if cfg.memory_guard %}
    check_memory(modeller.topology.getNumAtoms())
{% endif %}

    system = build_system(modeller.topology, forcefield)

    # Relax before the restraints go on: the restraint reference coordinates
    # should be the relaxed positions, not the clashing ones straight out of
    # addSolvent, or the restraints would pull the structure back into its own
    # steric overlaps.
    modeller.positions = relax(system, modeller.positions)

{% if cfg.use_positional_restraints %}
    add_restraints(system, modeller.topology, modeller.positions)
{% endif %}

    plat, properties, benchmark = select_platform(system, modeller.topology, modeller.positions)

    for replicate in range({{ derived.replicates }}):
{% if derived.replicates > 1 %}
        print()
        info(f"replicate {replicate + 1} of {{ derived.replicates }}")
{% endif %}
        simulate(replicate, modeller, forcefield, system, plat, properties, benchmark)

    console.print()
    summary = Table(box=None, show_header=False, pad_edge=False, padding=(0, 2, 0, 0))
    summary.add_column("", style="muted")
    # fold, not the default ellipsis: the output path is the one line in this
    # summary a reader may need to copy, and "...ratchpad/richrun" cannot be.
    summary.add_column("", overflow="fold")
    summary.add_row("wall time", f"[value]{_fmt_duration(time.time() - started_at)}[/value]")
    summary.add_row("output", str(OUTPUT))
    try:
        summary.add_row("peak memory",
                        f"{_human_bytes(psutil.Process().memory_info().rss)} resident")
        if _SWAP_AT_START is not None:
            grown = psutil.swap_memory().used - _SWAP_AT_START
            summary.add_row("swap", f"{_human_bytes(grown)} added by this run"
                            + ("  [warn](throughput will have suffered)[/warn]"
                               if grown > 512e6 else ""))
    except Exception:
        pass
    ok("all runs complete")
    console.print(summary)
    console.print()
    info("next: run  ./analyse.py  to build the .fxa results file for the Analysis tab")
    return 0


if __name__ == "__main__":
    sys.exit(main())
