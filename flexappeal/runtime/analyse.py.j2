#!/usr/bin/env python3
"""Analysis pass for {{ cfg.job_name }}.

Generated by FlexAppeal {{ version }} on {{ generated_at }}.

Runs against the COMPLETE trajectory on this machine, then packs the results
into a single `.fxa` file for the Analysis tab. Doing it here rather than
server-side is the whole point: no metric is computed on decimated data, and
what travels back is tens of megabytes rather than gigabytes.

The full trajectory stays here. Nothing in this script uploads anything.
"""

from __future__ import annotations

import json
import hashlib
import sys
import zipfile
from datetime import datetime, timezone
from pathlib import Path

import numpy as np

try:
    import mdtraj as md
    import psutil
    from rich.console import Console
    from rich.progress import BarColumn, TaskProgressColumn
    from rich.progress import Progress as RichProgress
    from rich.progress import TextColumn, TimeElapsedColumn
    from rich.table import Table
    from rich.theme import Theme
except ImportError as exc:
    print(f"{exc.name} is missing -- run this through the bundle "
          f"(pixi run python analyse.py)")
    sys.exit(1)

HERE = Path(__file__).resolve().parent
OUTPUT = (HERE / {{ cfg.output_dir | tojson }}).resolve()
JOB_NAME = {{ cfg.job_name | tojson }}
FLEXAPPEAL_VERSION = {{ version | tojson }}

METRICS = {{ cfg.analysis_metrics | tojson }}
PAYLOAD_TIER = {{ cfg.payload_tier | tojson }}
ALIGN_SELECTION = {{ cfg.analysis_selection | tojson }}
REFERENCE = {{ cfg.analysis_reference | tojson }}

# Frames and atom handling per tier. The full trajectory always stays local;
# this only governs what is packed for the web app to view and re-analyse.
TIERS = {
    "light":    {"frames": 100,  "selection": "protein"},
    "standard": {"frames": 500,  "selection": "protein"},
    "full":     {"frames": 2000, "selection": "all"},
}

# A copy of flexappeal/console.py's THEME, for the same reason run.py carries
# one: this script runs in the bundle's environment, where there is no
# FlexAppeal package to import from. The test suite asserts they match.
THEME = Theme({
    "info": "#1e73be",
    "ok": "#00d084",
    "warn": "#fcb900",
    "err": "#d63638",
    "muted": "#6b7c93",
    "step": "#1e73be",
    "heading": "bold #1e73be",
    "value": "bold",
    "bar.complete": "#1e73be",
    "bar.finished": "#00d084",
    "bar.pulse": "#1e73be",
    "progress.percentage": "#6b7c93",
    "progress.elapsed": "#6b7c93",
})

console = Console(theme=THEME)
err_console = Console(theme=THEME, stderr=True)
_TTY = console.is_terminal

def info(m):  console.print(f"[info]\u2139[/info] {m}")
def ok(m):    console.print(f"[ok]\u2713[/ok] {m}")
def warn(m):  console.print(f"[warn]\u26a0[/warn] {m}")
def fail(m):  err_console.print(f"[err]\u2717[/err] {m}")


def _human_bytes(n):
    for unit in ("B", "kB", "MB", "GB", "TB"):
        if abs(n) < 1000 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1000.0
    return f"{n:.1f} TB"


def _vitals():
    """Resident size and free memory, for the progress line.

    Analysis is the memory-hungry half of a bundle: MDTraj holds the whole
    trajectory in RAM, so a long run can need several times the peak of the
    simulation that produced it. Showing it means an approaching MemoryError is
    visible before it happens rather than only in the traceback.
    """
    try:
        return (f"{_human_bytes(psutil.Process().memory_info().rss)} rss "
                f"\u00b7 {_human_bytes(psutil.virtual_memory().available)} free")
    except Exception:
        return ""


# step() is the one output call the metric bodies make, and there are eighteen
# of them. Rather than wrap each in progress bookkeeping, step() itself drives
# the bar when one is running: begin_metrics() opens it, every step() advances
# it and relabels it, end_metrics() closes it. Off a terminal, or outside the
# metric section, it stays the plain line it always was.
_METRICS_BAR = {"bar": None, "task": None}


def begin_metrics(total):
    if not _TTY:
        return
    bar = RichProgress(
        TextColumn("  [step]{task.fields[metric]}[/step]"),
        BarColumn(bar_width=26, complete_style="bar.complete",
                  finished_style="bar.finished"),
        TaskProgressColumn(),
        TextColumn("[muted]{task.fields[vitals]}[/muted]"),
        TimeElapsedColumn(),
        console=console, transient=True)
    _METRICS_BAR["task"] = bar.add_task("", total=max(1, total), metric="", vitals="")
    _METRICS_BAR["bar"] = bar
    bar.start()


def end_metrics():
    bar = _METRICS_BAR["bar"]
    if bar is not None:
        bar.stop()
        _METRICS_BAR["bar"] = _METRICS_BAR["task"] = None


def step(m):
    bar = _METRICS_BAR["bar"]
    if bar is None:
        console.print(f"[step]\u2192[/step] {m}")
        return
    bar.update(_METRICS_BAR["task"], metric=m, vitals=_vitals())
    bar.advance(_METRICS_BAR["task"])


def lipid_selection(name):
    """An MDTraj selection matching a lipid under either spelling.

    A PDB residue name is three characters wide, so POPC is written and read
    back as POP. Selecting on the configured name alone matches nothing, and the
    failure is silent -- every membrane metric just returns empty.
    """
    names = {name, name[:3]}
    return " or ".join(f"resname {n}" for n in sorted(names))


_MDTRAJ_SELECTION = {
    "protein": "protein",
    "protein_heavy": "protein and not element H",
    "backbone": "backbone",
    "ca": "name CA",
    "protein_ligand": "not water and not (resname NA CL K MG CA ZN)",
    "all": "all",
}


def load(run_dir):
    """Load a run's trajectory with its subset-matched topology."""
    topology = run_dir / "topology.pdb"
    if not topology.is_file():
        raise FileNotFoundError(f"{topology} is missing -- did the run finish?")

    candidates = sorted(run_dir.glob("trajectory.*"))
    if not candidates:
        raise FileNotFoundError(f"no trajectory in {run_dir}")

    step(f"loading {candidates[0].name}")
    traj = md.load(str(candidates[0]), top=str(topology))
    ok(f"{traj.n_frames} frames, {traj.n_atoms} atoms, {traj.time[-1] / 1000:.1f} ns")

{% if cfg.enforce_periodic_box %}
    # The trajectory was written with enforcePeriodicBox, which wraps every
    # molecule into the primary cell independently. A bound ligand can therefore
    # sit a whole box length from its protein in the stored coordinates, which
    # quietly ruins any distance or RMSD that spans two molecules.
    # compute_contacts applies the minimum image convention itself, so a contact
    # map looks perfectly correct while the distances beside it are nonsense --
    # which is what makes this worth undoing up front rather than per metric.
    # The anchor has to be named explicitly. MDTraj's own heuristic looks for a
    # molecule with *more* atoms than the largest one, which can never be
    # satisfied for a protein plus a ligand, and it fails with:
    #   "Could not find any anchor molecules. Based on our heuristic, those
    #    should be molecules with more than 3220 atoms."
    if traj.unitcell_vectors is not None:
        try:
            molecules = traj.topology.find_molecules()
            if molecules:
                traj.image_molecules(
                    inplace=True, anchor_molecules=[max(molecules, key=len)])
                info("re-imaged molecules (undoing periodic wrapping)")
        except (ValueError, RuntimeError, IndexError) as exc:
            warn(f"could not re-image molecules ({exc}); distances that span "
                 f"two molecules may be wrong by a box length")
{% endif %}
    return traj


def reference_frame(traj, run_dir):
    """The structure RMSD and native contacts are measured against."""
    if REFERENCE == "minimized" and (run_dir / "minimised.pdb").is_file():
        try:
            ref = md.load(str(run_dir / "minimised.pdb"))
            # The minimised structure has the whole solvated system; keep only
            # the atoms the trajectory actually contains.
            return ref.atom_slice(ref.top.select(_MDTRAJ_SELECTION[ALIGN_SELECTION]))
        except Exception as exc:
            warn(f"could not use the minimised structure as reference ({exc}); using frame 0")
    elif REFERENCE == "average":
        mean = traj.xyz.mean(axis=0, keepdims=True)
        ref = traj[0][:]
        ref.xyz = mean
        return ref
    return traj[0]


def compute(traj, run_dir):
    """Every requested metric, computed against the full trajectory."""
    metrics = {}
    arrays = {}
    top = traj.topology

    # +1 for the superposition, which is a step() but not a METRICS entry.
    begin_metrics(len(METRICS) + 1)

    align = top.select(_MDTRAJ_SELECTION[ALIGN_SELECTION])
    if len(align) == 0:
        warn(f"the alignment selection {ALIGN_SELECTION!r} matched nothing; using all atoms")
        align = np.arange(traj.n_atoms)

    protein = top.select("protein")
    time_ns = (traj.time / 1000.0).tolist()
    metrics["time_ns"] = time_ns

    step("superposing")
    ref = reference_frame(traj, run_dir)
    try:
        traj.superpose(ref, atom_indices=align,
                       ref_atom_indices=align if ref.n_atoms == traj.n_atoms else None)
    except (ValueError, IndexError):
        # A reference with a different atom count cannot be used for fitting;
        # fall back to the first frame rather than failing the whole analysis.
        warn("the reference structure does not match the trajectory; aligning on frame 0")
        ref = traj[0]
        traj.superpose(ref, atom_indices=align)

    if "rmsd" in METRICS:
        step("RMSD")
        metrics["rmsd_nm"] = md.rmsd(traj, ref, atom_indices=align).tolist()

    if "rmsf" in METRICS and len(protein):
        step("RMSF")
        ca = top.select("name CA")
        if len(ca):
            fluct = md.rmsf(traj, traj, 0, atom_indices=ca)
            metrics["rmsf_nm"] = fluct.tolist()
            metrics["rmsf_resids"] = [top.atom(i).residue.resSeq for i in ca]
            metrics["rmsf_resnames"] = [top.atom(i).residue.name for i in ca]

    if "rgyr" in METRICS and len(protein):
        step("radius of gyration")
        metrics["rgyr_nm"] = md.compute_rg(traj.atom_slice(protein)).tolist()

    if "sasa" in METRICS and len(protein):
        step("SASA (slow)")
        sasa = md.shrake_rupley(traj.atom_slice(protein), mode="residue")
        metrics["sasa_total_nm2"] = sasa.sum(axis=1).tolist()
        arrays["sasa_per_residue"] = sasa.astype(np.float32)

    if "dssp" in METRICS and len(protein):
        step("secondary structure")
        try:
            dssp = md.compute_dssp(traj.atom_slice(protein), simplified=True)
            codes = {"H": 0, "E": 1, "C": 2, "NA": 3}
            arrays["dssp"] = np.vectorize(lambda c: codes.get(c, 3))(dssp).astype(np.int8)
            metrics["dssp_legend"] = {"0": "helix", "1": "sheet", "2": "coil", "3": "none"}
            metrics["dssp_helix_fraction"] = (dssp == "H").mean(axis=1).tolist()
            metrics["dssp_sheet_fraction"] = (dssp == "E").mean(axis=1).tolist()
        except Exception as exc:
            warn(f"DSSP failed ({exc})")

    if "hbonds" in METRICS and len(protein):
        step("hydrogen bonds")
        try:
            sub = traj.atom_slice(protein)
            bonds = md.baker_hubbard(sub, freq=0.1, periodic=False)
            metrics["hbonds"] = [
                {
                    "donor": str(sub.top.atom(d)),
                    "hydrogen": str(sub.top.atom(h)),
                    "acceptor": str(sub.top.atom(a)),
                }
                for d, h, a in bonds
            ][:500]
            metrics["hbond_count"] = len(bonds)
        except Exception as exc:
            warn(f"hydrogen bond analysis failed ({exc})")

    if "contacts" in METRICS and len(protein):
        step("contact map")
        try:
            sub = traj.atom_slice(protein)
            pairs = [(i, j) for i in range(sub.top.n_residues)
                     for j in range(i + 3, sub.top.n_residues)]
            if len(pairs) > 250_000:
                warn(f"{len(pairs)} residue pairs; skipping the contact map")
            else:
                distances, _ = md.compute_contacts(sub, contacts=pairs, scheme="closest-heavy")
                occupancy = (distances < 0.45).mean(axis=0)
                n = sub.top.n_residues
                matrix = np.zeros((n, n), dtype=np.float32)
                for (i, j), value in zip(pairs, occupancy):
                    matrix[i, j] = matrix[j, i] = value
                arrays["contact_map"] = matrix
                metrics["contact_residues"] = [r.resSeq for r in sub.top.residues]
        except Exception as exc:
            warn(f"contact map failed ({exc})")

    if "nativecontacts" in METRICS and len(protein):
        step("native contacts")
        try:
            sub = traj.atom_slice(protein)
            pairs = [(i, j) for i in range(sub.top.n_residues)
                     for j in range(i + 4, sub.top.n_residues)]
            distances, _ = md.compute_contacts(sub, contacts=pairs, scheme="closest-heavy")
            native = distances[0] < 0.45
            if native.any():
                metrics["native_contacts_q"] = (
                    (distances[:, native] < 0.45).mean(axis=1)).tolist()
        except Exception as exc:
            warn(f"native contacts failed ({exc})")

    if "pca" in METRICS and len(protein) > 10:
        step("principal component analysis")
        try:
            ca = top.select("name CA")
            if len(ca) >= 3:
                coords = traj.atom_slice(ca).xyz.reshape(traj.n_frames, -1)
                coords = coords - coords.mean(axis=0)
                # SVD rather than an explicit covariance eigendecomposition: for
                # 3N >> n_frames the covariance matrix is both huge and rank
                # deficient, and SVD gets the same components without forming it.
                _, singular, components = np.linalg.svd(coords, full_matrices=False)
                variance = singular ** 2 / (traj.n_frames - 1)
                metrics["pca_variance_ratio"] = (
                    variance[:10] / variance.sum()).tolist()
                projection = coords @ components[:3].T
                metrics["pca_projection"] = projection.astype(np.float32).tolist()
                arrays["pca_components"] = components[:3].astype(np.float32)
        except Exception as exc:
            warn(f"PCA failed ({exc})")

    if "clusters" in METRICS and len(protein):
        step("conformational clustering")
        try:
            ca = top.select("name CA")
            stride = max(1, traj.n_frames // 500)   # cap the pairwise matrix
            sub = traj.atom_slice(ca)[::stride]
            n = sub.n_frames
            matrix = np.empty((n, n), dtype=np.float32)
            for i in range(n):
                matrix[i] = md.rmsd(sub, sub, i)
            arrays["rmsd_matrix"] = matrix
            metrics["rmsd_matrix_stride"] = stride

            # Greedy clustering at a fixed cutoff: no scipy dependency, no
            # parameter to tune, and adequate for "show me the distinct states".
            cutoff = 0.2
            unassigned = set(range(n))
            clusters = []
            while unassigned and len(clusters) < 10:
                counts = {i: int((matrix[i] < cutoff).sum()) for i in unassigned}
                centre = max(counts, key=counts.get)
                members = [j for j in unassigned if matrix[centre][j] < cutoff]
                clusters.append({
                    "centre_frame": centre * stride,
                    "size": len(members),
                    "fraction": len(members) / n,
                })
                unassigned -= set(members)
            metrics["clusters"] = clusters
        except Exception as exc:
            warn(f"clustering failed ({exc})")

{% if ligand_names %}
    LIGAND_RESIDUES = {{ ligand_names | tojson }}
    ligand_sel = " or ".join(f"resname {name}" for name in LIGAND_RESIDUES)
    ligand_atoms = top.select(ligand_sel) if LIGAND_RESIDUES else np.array([])

    if "ligand_rmsd" in METRICS and len(ligand_atoms):
        step("ligand RMSD")
        try:
            # The trajectory is already superposed on the protein, so this
            # measures how far the ligand moves *within the binding site* rather
            # than how far the whole complex tumbled -- which is the question.
            metrics["ligand_rmsd_nm"] = md.rmsd(
                traj, ref, atom_indices=ligand_atoms,
                ref_atom_indices=ligand_atoms if ref.n_atoms == traj.n_atoms else None,
            ).tolist()
        except (ValueError, IndexError) as exc:
            warn(f"ligand RMSD failed ({exc})")

    if "ligand_contacts" in METRICS and len(ligand_atoms) and len(protein):
        step("protein-ligand contacts")
        try:
            # A residue with no heavy atoms makes closest-heavy fail with an
            # opaque "zero-size array to reduction operation minimum". Filtered
            # rather than caught, so one odd residue does not lose the panel.
            def has_heavy(index):
                return any(a.element.symbol != "H" for a in top.residue(index).atoms)

            ligand_residues = sorted({top.atom(i).residue.index for i in ligand_atoms
                                      if has_heavy(top.atom(i).residue.index)})
            protein_residues = sorted({top.atom(i).residue.index for i in protein
                                       if has_heavy(top.atom(i).residue.index)})
            pairs = [(p, l) for l in ligand_residues for p in protein_residues]
            distances, _ = md.compute_contacts(traj, contacts=pairs, scheme="closest-heavy")
            occupancy = (distances < 0.4).mean(axis=0)

            contacts = []
            for (p, _), value in zip(pairs, occupancy):
                if value > 0.05:
                    residue = top.residue(p)
                    contacts.append({
                        "residue": f"{residue.name}{residue.resSeq}",
                        "resid": int(residue.resSeq),
                        "occupancy": float(value),
                    })
            contacts.sort(key=lambda c: c["occupancy"], reverse=True)
            metrics["ligand_contacts"] = contacts[:40]
            metrics["ligand_contact_count"] = len(contacts)
        except (ValueError, IndexError) as exc:
            warn(f"ligand contacts failed ({exc})")
{% endif %}

{% if cfg.use_membrane %}
    if "membrane_apl" in METRICS:
        step("area per lipid")
        try:
            lipids = top.select(lipid_selection("{{ cfg.lipid_type }}"))
            n_lipids = len({r for r in (top.atom(i).residue.index for i in lipids)})
            if n_lipids and traj.unitcell_lengths is not None:
                # Box cross-section divided by lipids per leaflet. This counts
                # the protein's own cross-section as membrane area, so the
                # absolute value runs high for a large complex -- it is a
                # convergence diagnostic (watch it plateau) rather than a
                # measurement to compare against a pure-bilayer literature value.
                area = traj.unitcell_lengths[:, 0] * traj.unitcell_lengths[:, 1]
                metrics["area_per_lipid_nm2"] = (area / (n_lipids / 2)).tolist()
                metrics["lipid_count"] = n_lipids
                metrics["area_per_lipid_note"] = (
                    "includes the protein cross-section; a convergence "
                    "diagnostic rather than an absolute measurement"
                )
        except Exception as exc:
            warn(f"area per lipid failed ({exc})")

    if "membrane_scd" in METRICS:
        step("lipid order parameters")
        try:
            # -S_CD per tail carbon. The order parameter is
            #     S_CD = <3cos^2(theta) - 1> / 2
            # with theta the angle between each C-H bond and the bilayer normal
            # (z). CHARMM36 names the sn-1 chain carbons C2n and their hydrogens
            # HnR/HnS/HnX/HnY, so the pairs are found by name rather than by
            # walking connectivity.
            lipid = "{{ cfg.lipid_type }}"
            profile = []
            for carbon_index in range(2, 17):
                carbon = top.select(
                    f"({lipid_selection(lipid)}) and name C2{carbon_index}")
                if not len(carbon):
                    continue
                values = []
                for suffix in ("R", "S", "X", "Y"):
                    hydrogen = top.select(
                        f"({lipid_selection(lipid)}) and name H{carbon_index}{suffix}")
                    if len(hydrogen) != len(carbon):
                        continue
                    vectors = traj.xyz[:, hydrogen, :] - traj.xyz[:, carbon, :]
                    norms = np.linalg.norm(vectors, axis=2)
                    with np.errstate(invalid="ignore", divide="ignore"):
                        cos_theta = vectors[:, :, 2] / norms
                    scd = 0.5 * (3.0 * cos_theta ** 2 - 1.0)
                    values.append(float(np.nanmean(scd)))
                if values:
                    # Reported as -S_CD, which is the convention in the
                    # literature and makes an ordered chain read as positive.
                    profile.append({"carbon": carbon_index,
                                    "scd": -float(np.mean(values))})
            if profile:
                metrics["lipid_order_parameters"] = profile
        except Exception as exc:
            warn(f"lipid order parameters failed ({exc})")

    if "membrane_thickness" in METRICS:
        step("bilayer thickness")
        try:
            phosphates = top.select(f"({lipid_selection('{{ cfg.lipid_type }}')}) and name P")
            if len(phosphates):
                z = traj.xyz[:, phosphates, 2]
                midplane = z.mean(axis=1, keepdims=True)
                upper = np.where(z >= midplane, z, np.nan)
                lower = np.where(z < midplane, z, np.nan)
                metrics["bilayer_thickness_nm"] = (
                    np.nanmean(upper, axis=1) - np.nanmean(lower, axis=1)).tolist()
        except Exception as exc:
            warn(f"bilayer thickness failed ({exc})")
{% endif %}

    end_metrics()
    return metrics, arrays


def decimate(traj):
    """Cut the trajectory down to what the results file will carry."""
    tier = TIERS.get(PAYLOAD_TIER, TIERS["standard"])
    selection = _MDTRAJ_SELECTION[tier["selection"]]
{% if ligand_names %}
    # MDTraj's "protein" selection does not include a ligand, so the lighter
    # tiers would pack the binding site empty -- the metrics would be right (they
    # are computed on the full trajectory) but the viewer would show a hole where
    # the ligand should be.
    if tier["selection"] == "protein":
        selection = " or ".join(
            [selection] + [f"resname {name}" for name in {{ ligand_names | tojson }}])
{% endif %}
    indices = traj.top.select(selection)
    if len(indices) == 0:
        indices = np.arange(traj.n_atoms)

    stride = max(1, traj.n_frames // tier["frames"])
    out = traj.atom_slice(indices)[::stride]
    info(f"packing {out.n_frames} frames of {out.n_atoms} atoms "
         f"({PAYLOAD_TIER} tier, stride {stride})")
    return out, stride


def pack(run_dir, traj, metrics, arrays, stride):
    """Write the .fxa: one zip, documented manifest, checksums for everything."""
    fxa = OUTPUT / f"{JOB_NAME}{run_dir.name.replace(JOB_NAME, '')}.fxa"
    staging = run_dir / "_fxa"
    staging.mkdir(exist_ok=True)

    decimated, stride = decimate(traj)
    traj_path = staging / "traj.xtc"
    decimated.save_xtc(str(traj_path))
    top_path = staging / "topology.pdb"
    decimated[0].save_pdb(str(top_path))

    metrics_path = staging / "metrics.json"
    metrics_path.write_text(json.dumps(metrics))

    arrays_path = staging / "arrays.npz"
    if arrays:
        np.savez_compressed(str(arrays_path), **arrays)

    run_manifest = {}
    if (run_dir / "run_manifest.json").is_file():
        run_manifest = json.loads((run_dir / "run_manifest.json").read_text())

    config = {}
    if (HERE / "config.json").is_file():
        config = json.loads((HERE / "config.json").read_text())

{% if cfg.use_refstates %}
    refstates_path = reference_states(run_dir, staging)
{% else %}
    refstates_path = None
{% endif %}

    members = {
        "metrics.json": metrics_path,
        "traj.xtc": traj_path,
        "topology.pdb": top_path,
    }
    if arrays:
        members["arrays.npz"] = arrays_path
    for name in ("state_data.csv",):
        if (run_dir / name).is_file():
            members[name] = run_dir / name
    if refstates_path is not None:
        members["refstates.json"] = refstates_path

    manifest = {
        "fxa_version": 1,
        "flexappeal_version": FLEXAPPEAL_VERSION,
        "job_name": JOB_NAME,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "payload_tier": PAYLOAD_TIER,
        "metrics_computed": METRICS,
        "trajectory": {
            "frames_packed": decimated.n_frames,
            "frames_analysed": traj.n_frames,
            "atoms_packed": decimated.n_atoms,
            "stride": stride,
            "duration_ns": float(traj.time[-1] / 1000.0) if traj.n_frames else 0.0,
        },
        "run": run_manifest,
        "config": config.get("config", {}),
        "structure": config.get("structure", {}),
        "files": {
            name: {
                "bytes": path.stat().st_size,
                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            }
            for name, path in members.items()
        },
    }

    with zipfile.ZipFile(fxa, "w", zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("manifest.json", json.dumps(manifest, indent=2))
        for name, path in members.items():
            archive.write(path, name)

    for path in staging.iterdir():
        path.unlink()
    staging.rmdir()

    size_mb = fxa.stat().st_size / 1e6
    ok(f"wrote {fxa.name} ({size_mb:.1f} MB)")
    return fxa


{% if ligand_names %}
def binding_energy(run_dir):
    """MM/GBSA for this run, computed once and used twice.

    Once into the version 1 results file, so the Analysis tab can show the
    number: that page reads the version 1 payload and nothing else, so an energy
    that exists only in the version 2 package is an energy the reader never sees.
    Once into the package, where DeepFlex scores it.

    Computing it twice would be two minutes wasted and, worse, two numbers: the
    frames are subsampled, so a second run is a second sample of the same
    trajectory and the two would disagree in the last decimal.
    """
    from fxalib import energy as energylib

    ok, reason = energylib.available()
    if not ok:
        warn(f"{reason}. The energy sub-score will be pending; the other five "
             f"are unaffected.")
        return {}, []

    step("MM/GBSA binding energy")
    # The receptor token here is only part of a lookup key, and `as_supplied`
    # also files the energy under the compound alone, so the package finds it
    # whichever token it derives from the structure.
    supplied, notes = energylib.for_run_directory(
        HERE, run_dir, receptor=JOB_NAME, keep_in=run_dir,
        progress=lambda message: step(message))
    return supplied, notes


def energy_metrics(supplied):
    """The energy keys, flattened for the version 1 metrics block.

    Version 1 has no energy section, so these go in beside the other metrics
    under the names the spec uses. Additive: a reader that does not know them
    ignores them, which is how the format has always treated a metric it was not
    expecting.
    """
    if not supplied:
        return {}
    entry = next(iter(supplied.values()))
    out = {key: value for key, value in entry.items() if key != "terms"}
    terms = (entry.get("terms") or {}).get("gb") or {}
    if terms:
        out["mmpbsa_gb_terms"] = terms
    return out


def package_v2(run_dirs, supplied):
    """Write the graded version 2 package beside the version 1 results files.

    Spec section 0: a run with a ligand emits version 2, because version 1 has
    nowhere to put a ligand measurement and the grade would be lost rather than
    deferred. A one-complex package is a first-class graded run -- it gets a
    letter, a score and five of the six sub-scores. What it does not get is a
    league table or a rank, which are properties of a cohort.

    The version 1 file is still written, and is not a duplicate of this one. It
    carries the whole-system analysis -- backbone RMSD, radius of gyration, SASA,
    secondary structure, the contact map, the essential dynamics -- plus the
    topology and a decimated trajectory for the viewer, none of which a version 2
    package has anywhere to put. The two are different reports of one run, not two
    versions of one report, so both are produced and the Analysis tab and DeepFlex
    each read the one meant for them.

    Measured from the run directory rather than from the version 1 file, which
    matters: the version 1 payload is decimated for viewing, and measuring a
    pocket on it would put the grade on thinned data.
    """
    # The vendored copy of FlexAppeal's own measurement library, byte for byte
    # what built this bundle. Imported here rather than at the top of the file so
    # an apo-shaped failure in it cannot stop the version 1 file being written.
    from fxalib import package as packlib

    out = OUTPUT / f"{JOB_NAME}_package.fxa"
    lines = []
    try:
        path, warnings = packlib.build(
            list(run_dirs), out=out, package_name=JOB_NAME,
            # Already computed, above, so that the version 1 file could carry it
            # too. `energies` rather than `mmgbsa=True` on purpose: this is the
            # same route a study's own numbers take, and it means the two files
            # carry one number rather than two samples of it.
            energies=supplied or None,
            progress=lambda message: step(message))
    except Exception as exc:                        # noqa: BLE001
        warn(f"the version 2 package could not be built ({exc}). The version 1 "
             f"results file above is unaffected and the Analysis tab reads it.")
        return None, []
    for line in warnings:
        lines.append(line)
    size_mb = path.stat().st_size / 1e6
    ok(f"wrote {path.name} ({size_mb:.1f} MB)")
    return path, lines
{% endif %}


{% if cfg.use_refstates %}
def reference_states(run_dir, staging):
    """Score every motif against the experimental reference structures.

    No catalogue and no network. Which residues each motif is, which residues
    the superposition core is, and the coordinates to score against were all
    resolved when this bundle was built, where KLIFS or GPCRdb could be asked,
    and they travel in `refstates/ensemble.json`. What happens here is numpy:
    superpose each frame on the core and measure.

    Returns the path to the member, or None where it could not be done, which
    is never fatal: the rest of the results file is unaffected and the reason
    is printed.
    """
    import json as json_mod

    ensemble_file = HERE / "refstates" / "ensemble.json"
    if not ensemble_file.is_file():
        warn("the reference-state ensemble is missing from this bundle, so no "
             "motif can be scored")
        return None

    step("reference states")
    try:
        from fxalib.refstates import traj as rstraj

        payload = json_mod.loads(ensemble_file.read_text())
        trajectory = sorted(run_dir.glob("trajectory.*"))[0]
        loaded = rstraj.load(run_dir / "topology.pdb", trajectory, stride=1)

        # The deposited numbering, which OpenMM renumbered away on solvation.
        # Every motif in the ensemble is addressed by a deposited number, so
        # without this each one would be read at the wrong residues and would
        # still return numbers that look like measurements.
        mapping = rstraj.deposited_numbering(HERE / "{{ structure_filename }}",
                                             loaded.topology)
        changed = rstraj.renumber(loaded.topology, mapping)
        info(f"{changed} residues restored to deposited numbering")

        core = rstraj.Core(residues=payload["core"]["residues"],
                           source=payload["core"].get("source", ""),
                           helices=payload["core"].get("helices") or {})
        run = rstraj.analyse(
            loaded, name=JOB_NAME, kind=payload["kind"], core=core,
            motif_residues={k: list(v) for k, v
                            in payload["motif_residues"].items()},
            reference_motifs=payload["reference_motifs"],
            frame_ps={{ cfg.traj_interval }})
    except Exception as exc:                        # noqa: BLE001
        warn(f"the reference-state scoring could not be completed ({exc}). "
             f"Every other panel is unaffected.")
        return None

    out = run.as_row()

    # The smoothed series the state-score panel draws, and the raw one beside
    # it. Section 5.6 asks for a centred window for display only, with the raw
    # values stored, so both travel and the stored numbers are never the
    # altered ones.
    from fxalib.refstates.state import SMOOTH_WINDOW_NS, smooth

    whole = [f.whole_s for f in run.frames]
    if any(v is not None for v in whole):
        out["whole_s_raw"] = [None if v is None else round(v, 4) for v in whole]
        span_ns = len(whole) * {{ cfg.traj_interval }} / 1000.0
        if span_ns > 2.0 * SMOOTH_WINDOW_NS:
            out["whole_s_smoothed"] = [
                None if v is None else round(v, 4)
                for v in smooth(whole, frame_ps={{ cfg.traj_interval }})]
            out["smoothing_window_ns"] = SMOOTH_WINDOW_NS
        else:
            # A window wider than the run averages the series into one value
            # repeated, which reads as a flat trace rather than as a window
            # that does not apply.
            out["smoothing_skipped"] = (
                f"run is {span_ns:.1f} ns against a "
                f"{SMOOTH_WINDOW_NS} ns window")

    # And the DSSP ribbon, against the reference ensembles' own consensus,
    # which the build-time setup resolved and the payload carries.
    try:
        from fxalib.refstates.sse import (profiles_from_json,
                                          secondary_structure)

        dssp = secondary_structure(
            loaded, {k: list(v) for k, v in payload["motif_residues"].items()},
            profiles_from_json((payload.get("report") or {}).get("sse_profiles")))
        if dssp:
            out["dssp"] = dssp
    except Exception as exc:                        # noqa: BLE001
        warn(f"the secondary-structure ribbon could not be computed ({exc})")

    out["ensembles"] = payload.get("ensembles", {})
    out["report"] = payload.get("report", {})
    out["motif_residues"] = payload["motif_residues"]
    out["core"] = payload["core"]
    out["system_id"] = payload.get("protein") or payload["kind"]
    path = staging / "refstates.json"
    path.write_text(json_mod.dumps(out))

    last = run.frames[-1] if run.frames else None
    if last is not None and last.whole_s is not None:
        ok(f"final frame scores {last.whole_s:+.3f} ({last.whole_label}) "
           f"against {sum(payload['counts'].values())} reference structures")
    return path


{% endif %}


def main():
    print()
    info(f"FlexAppeal {FLEXAPPEAL_VERSION} — analysing {JOB_NAME}")
    print()

    run_dirs = sorted(d for d in OUTPUT.glob(f"{JOB_NAME}*") if d.is_dir())
    if not run_dirs:
        fail(f"no run directory found in {OUTPUT}. Run the simulation first.")
        return 1

    written = []
    energies = {}
    for run_dir in run_dirs:
        try:
            traj = load(run_dir)
        except (FileNotFoundError, OSError) as exc:
            warn(f"skipping {run_dir.name}: {exc}")
            continue
        if traj.n_frames < 2:
            warn(f"skipping {run_dir.name}: only {traj.n_frames} frame(s)")
            continue

        metrics, arrays = compute(traj, run_dir)
{% if ligand_names %}
        # Before packing, so the number travels in the version 1 file as well as
        # in the package. The Analysis tab reads version 1 and nothing else.
        energies, energy_notes = binding_energy(run_dir)
        metrics.update(energy_metrics(energies))
        for note in energy_notes:
            warn(note)
{% endif %}
        written.append(pack(run_dir, traj, metrics, arrays, 1))

    if not written:
        fail("nothing to analyse.")
        return 1

{% if ligand_names %}
    print()
    step("building the version 2 package")
    package_path, package_warnings = package_v2(run_dirs, energies)
    for line in package_warnings:
        warn(line)
{% else %}
    package_path = None
{% endif %}

    print()
    ok(f"{len(written)} results file(s) ready")
    for path in written:
        info(f"  {path}")
    info("upload to {{ site_url }}/analysis")
    if package_path is not None:
        print()
        info(f"  {package_path}")
        info("this one is the graded package: upload it to DeepFlex")
    return 0


if __name__ == "__main__":
    sys.exit(main())
