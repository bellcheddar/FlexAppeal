[workspace]
name = "{{ cfg.job_name }}"
version = "1.0.0"
description = "FlexAppeal run bundle for {{ cfg.job_name }}"
channels = ["conda-forge"]
platforms = ["osx-arm64"{% if allow_linux %}, "linux-64"{% endif %}]

# Environment for this specific run, generated by FlexAppeal {{ version }} on
# {{ generated_at }}. Only what this run actually needs is listed -- a bundle for
# an apo protein does not pull AmberTools, which is a gigabyte on its own.
#
# python = 3.11: openff-toolkit and openmmforcefields both lag the current
# Python release on conda-forge, and 3.11 is the newest with builds for
# everything here.

[dependencies]
python = "3.11.*"
openmm = "{{ openmm_pin }}"
numpy = "*"
{% if needs_pdbfixer %}
pdbfixer = "*"
{% endif %}
{% if needs_openmmforcefields %}
# {{ openmmforcefields_reason }}
openmmforcefields = "*"
openff-toolkit = "*"
# Transfers bond orders from the bundled chemical definitions onto the deposited
# coordinates, and adds the hydrogens a PDB HETATM record does not carry.
rdkit = "*"
{% if needs_ambertools %}
# AM1-BCC is computed by AmberTools' `sqm`. It arrives transitively via
# openmmforcefields today, but this is a hard requirement of the chosen charge
# method rather than an incidental one -- declared explicitly so a change in
# openmmforcefields' own dependencies cannot quietly remove it.
ambertools = "*"
{% endif %}
{% endif %}

# Analysis. MDTraj alone: it owns the trajectory formats and covers every metric
# analyse.py computes, including the membrane ones. MDAnalysis was listed here
# originally and never imported, which cost every bundle a dependency in its
# environment solve for nothing.
mdtraj = "*"
scipy = "*"

[tasks]
run = "python run.py"
analyse = "python analyse.py"

[activation.env]
# conda-forge's scientific stack and any pip-installed package bundling its own
# libomp will both initialise OpenMP in one process, which aborts on macOS with
# "OMP: Error #15 ... already initialized".
KMP_DUPLICATE_LIB_OK = "TRUE"
{% if cfg.cpu_threads %}
OPENMM_CPU_THREADS = "{{ cfg.cpu_threads }}"
{% endif %}
