# Copy to .env and fill in. .env is gitignored; nothing here is a secret.
#
# Section 0.2's G2: a credential arrives in the environment and is never
# written into a file that could be committed. These are names, not values.

# The repository job.sh clones on the pod. Public, so no credential is needed
# to read it. The MD inputs are not in it: data/ is gitignored, so the start
# structures and any prebuilt system come through RUNPOD_SYNC_URL.
FLEXAPPEAL_REPO=https://github.com/bellcheddar/FlexAppeal.git

# An rclone remote, which is why neither script knows whether it is S3,
# Backblaze or SFTP. Holds one directory per row. This is what makes a
# reclaimed pod survivable: without it the pod's disk is the only copy of the
# checkpoint, and the pod's disk does not survive the pod.
RUNPOD_SYNC_URL=

# Where job.sh clones and works, inside the pod.
WORK=/workspace
