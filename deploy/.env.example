# Copy to .env in the repo root and fill in. Never committed.

# Where to deploy. The droplet also hosts AlphaFraud, chem_sage, chatPDB and
# BoltzMaker, so FlexAppeal gets its own user, its own /opt directory and its
# own port.
DROPLET_SSH=root@45.55.102.228
DROPLET_PATH=/opt/flexappeal
# SSH_KEY=~/.ssh/id_ed25519

SERVER_NAME=flexappeal.mdeller.com

# 8000 AlphaFraud, 8001 chem_sage, 8002 chatPDB, 8003 BoltzMaker, 8004 here.
BIND_ADDR=127.0.0.1:8004

WEB_WORKERS=2
LOG_LEVEL=info
