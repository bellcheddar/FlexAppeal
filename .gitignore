# Environments
.venv/
.venv-dev/
.pixi/
__pycache__/
*.pyc
*.egg-info/

# Deployment secrets and per-machine config
.env

# Per-request working directories (web app)
web_scratch/

# Generated README artefacts (produced by marcs-vibe-coding readme_forge.py)
README.polished.md
README.html
README.preview.html
elementor-widget-markdown.css

# Simulation output -- these are large and regenerable.
# The negations keep the small checked-in example outputs tracked, so the
# analysis tab always has something real to render in tests.
*.fxa
*.xtc
*.dcd
*.chk
flexappeal_output/
*.command
# Capital E: the directory is Examples/, and these negations silently did
# nothing on Linux while appearing to work on the Mac's case-insensitive
# filesystem -- so the example results file would have been absent from the
# droplet and the Example tab would have shown its "not built yet" page in
# production only.
!Examples/*/*.fxa
!Examples/*/output/*.fxa
!Examples/*/*.command

# The extracted bundle and the raw capture are both regenerable from the two
# files above by rebuild.sh, and together they are ten megabytes of trajectory
# and repeated progress frames. The log compresses to 22 KB, so the evidence is
# kept in that form.
Examples/*/run/
Examples/*/terminal.log
Examples/*/analyse.log
!Examples/*/terminal.log.gz
!Examples/*/analyse.log.gz
# The test fixture is a real .fxa from a real run, and the whole analysis suite
# skips without it. Tracked deliberately despite the rule above.
!tests/fixtures/*.fxa

# macOS
.DS_Store
